DATABASE_URL="postgresql://user:password@localhost:5432/kuwana?schema=public"
NEXT_PUBLIC_SUPABASE_URL="https://xyz.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="publishable_key"
SUPABASE_SERVICE_ROLE_KEY="service_role_key"

# Anthropic and OpenRouter, used when an admin points a feature at a Claude or
# non-Anthropic model from /admin/llm. Neither is required if every feature's
# ladder only ever reaches the self-hosted Llama rung below — src/lib/ai/provider.ts
# picks the provider from the selected model, so only the key for the
# providers you actually select is required.
ANTHROPIC_API_KEY=sk-ant-xxx
OPENROUTER_API_KEY=sk-or-v1-xxx

# Deadline for an OpenRouter call (default 30000). Covers the whole call
# for JSON requests and time-to-first-byte for streaming ones. OpenRouter's
# `:free` tiers are a shared queue and can sit unanswered for over a
# minute; without this a busy free tier hangs the user's request.
OPENROUTER_TIMEOUT_MS=30000

# Comma-separated allowlist of emails granted admin access (src/lib/auth.ts requireAdmin).
ADMIN_EMAILS=admin@example.com

# Optional. Only set this if adopting the Helm/Kubernetes deploy track's shared
# Next.js cache handler (cache-handler.js) and the distributed rate limiter
# (src/lib/rateLimit.ts) — both fall back to safe single-process behavior when
# unset, which is correct for local dev and for the Vercel deploy.
# REDIS_URL="redis://localhost:6379"

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET` when
# it calls src/app/api/cron/*. Set the same value in the Vercel project's env
# vars as CRON_SECRET (Vercel then attaches it automatically to cron
# requests — you don't wire the header yourself). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Canonical production URL, used by robots.ts/sitemap.ts (absolute URLs are
# required there). Falls back to localhost:3000 if unset — set this once a
# real domain is live.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Reported by /api/health. Set by the container build (--build-arg APP_VERSION)
# and by the Helm chart; harmless to leave unset locally.
APP_VERSION=dev
# --- AI provider (Llama 3.2 Vision via Ollama-compat /api/chat) ---
# As of 2026-08-09, Kuwana talks to a self-hosted Llama 3.2 Vision endpoint
# via Ollama's native /api/chat surface (vision images + JSON Schema format
# both work there). Defaults match a local Ollama install:
#   ollama pull llama3.2-vision
#   ollama serve
# Any other server that speaks /api/chat (vLLM, llama.cpp, etc.) works too —
# just point LLAMA_VISION_BASE_URL at its root.
LLAMA_VISION_BASE_URL="http://localhost:11434"
LLAMA_VISION_MODEL="llama3.2-vision"
# Optional. Ollama ignores auth by default; only set if you fronted it with a
# gateway that requires one.
# LLAMA_VISION_API_KEY=""
