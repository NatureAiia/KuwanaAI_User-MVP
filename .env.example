DATABASE_URL="postgresql://user:password@localhost:5432/kuwana?schema=public"

# Optional. Connections this process may open (default 5, see
# src/lib/prismaAdapter.ts). Set by the Helm chart from
# `database.connectionLimit` so the fleet-wide budget is
# maxReplicas x this <= the server's max_connections.
#
# Note that a `?connection_limit=` parameter on DATABASE_URL does NOT do this:
# that is Prisma-engine syntax, and Prisma 7's `pg` driver adapter ignores it
# and applies pg's own default of 10 instead. This variable is the only thing
# that actually sizes the pool.
# DATABASE_POOL_MAX=5

# Auth is Auth.js (NextAuth v5), Credentials + JWT — generate with `openssl rand -base64 32`.
AUTH_SECRET="replace-with-a-real-32-byte-secret"
# Optional: only needed if trustHost's Host-header inference isn't reachable
# (e.g. behind a proxy that strips it). Vercel and the k3s ingress both work
# without it.
# AUTH_URL="https://your-domain.example"

# Supabase is Storage-only now (auth moved to Auth.js above) — still read by
# src/lib/supabase/admin.ts and src/lib/providerListingSchema.ts.
NEXT_PUBLIC_SUPABASE_URL="https://xyz.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service_role_key"

# Anthropic and OpenRouter, used when an admin points a feature at a Claude or
# non-Anthropic model from /admin/llm. Neither is required if every feature's
# ladder only ever reaches the self-hosted Llama rung below — src/lib/ai/provider.ts
# picks the provider from the selected model, so only the key for the
# providers you actually select is required.
ANTHROPIC_API_KEY=sk-ant-xxx
OPENROUTER_API_KEY=sk-or-v1-xxx

# Deadline for an OpenRouter call (default 30000). Covers the whole call
# for JSON requests and time-to-first-byte for streaming ones. OpenRouter's
# `:free` tiers are a shared queue and can sit unanswered for over a
# minute; without this a busy free tier hangs the user's request.
OPENROUTER_TIMEOUT_MS=30000

# Comma-separated allowlist of emails granted admin access (src/lib/auth.ts requireAdmin).
ADMIN_EMAILS=admin@example.com

# Cloudflare Turnstile. Both optional — with them unset the widget renders
# nothing and server-side verification is skipped, so local dev and any
# existing deploy behave exactly as before.
#
# IMPORTANT: setting these is only half the control. Supabase verifies the
# token for signUp/signInWithPassword, and it does that ONLY when CAPTCHA is
# enabled in the project's Auth settings with this same secret — a token
# passed to a project with it switched off is silently ignored. Our own routes
# (waitlist) verify via src/lib/turnstile.ts and need no dashboard step.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Hops in front of this app that append to x-forwarded-for (default 1, the
# usual single ingress or CDN). This decides which entry src/lib/rateLimit.ts
# treats as the caller: everything to the left of it is client-supplied, so
# setting this too LOW lets a caller spoof their way past every IP-keyed rate
# limit. Too high only over-groups callers, which is noisy rather than unsafe.
# TRUSTED_PROXY_COUNT=1

# --- Signup email verification (two-step) ---
# Sends a 6-digit code at signup and refuses to create the account until it
# comes back (src/lib/email/verification.ts). All optional, and the same
# configured-or-skip policy as Turnstile above: with SMTP_HOST or EMAIL_FROM
# unset, no mail is sent, no code is required, and signup behaves exactly as it
# did before this existed. So *setting these is what turns the control on* —
# a deployment without them is not protected.
#
# SMTP rather than a provider SDK, so the provider stays a deployment choice:
# Resend, SES, Postmark, SendGrid and Mailgun all expose one. EMAIL_FROM must
# be an address the provider has verified for your domain or every code
# bounces. SMTP_PORT defaults to 587 (STARTTLS, required not merely offered);
# 465 switches to implicit TLS on its own.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=
# EMAIL_FROM="Kuwana <no-reply@your-domain.example>"
#
# Optional. Keys the HMAC that protects stored code hashes — six digits is a
# 10^6 space, so an unkeyed hash column would be a lookup table rather than a
# secret. Derived from SUPABASE_SERVICE_ROLE_KEY via HKDF when unset, which is
# fine; set it to rotate code hashing on its own. Rotating invalidates codes
# currently in flight (a few minutes of failed signups, nothing persistent).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# EMAIL_VERIFICATION_SECRET=

# Optional. Only set this if adopting the Helm/Kubernetes deploy track's shared
# Next.js cache handler (cache-handler.js) and the distributed rate limiter
# (src/lib/rateLimit.ts) — both fall back to safe single-process behavior when
# unset, which is correct for local dev and for the Vercel deploy.
# REDIS_URL="redis://localhost:6379"

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET` when
# it calls src/app/api/cron/*. Set the same value in the Vercel project's env
# vars as CRON_SECRET (Vercel then attaches it automatically to cron
# requests — you don't wire the header yourself). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Canonical production URL, used by robots.ts/sitemap.ts (absolute URLs are
# required there). Falls back to localhost:3000 if unset — set this once a
# real domain is live.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Reported by /api/health. Set by the container build (--build-arg APP_VERSION)
# and by the Helm chart; harmless to leave unset locally.
APP_VERSION=dev
# --- AI provider (Llama 3.2 Vision via Ollama-compat /api/chat) ---
# As of 2026-08-09, Kuwana talks to a self-hosted Llama 3.2 Vision endpoint
# via Ollama's native /api/chat surface (vision images + JSON Schema format
# both work there). Defaults match a local Ollama install:
#   ollama pull llama3.2-vision
#   ollama serve
# Any other server that speaks /api/chat (vLLM, llama.cpp, etc.) works too —
# just point LLAMA_VISION_BASE_URL at its root.
LLAMA_VISION_BASE_URL="http://localhost:11434"
LLAMA_VISION_MODEL="llama3.2-vision"
# Optional. Ollama ignores auth by default; only set if you fronted it with a
# gateway that requires one.
# LLAMA_VISION_API_KEY=""

# --- Web scraper (/admin/scraper) ---
# URL of a self-hosted Firecrawl instance used to fetch/search pages before an
# admin reviews the extracted data. Firecrawl's own docker-compose builds from
# its source tree (apps/api, playwright-service, FoundationDB, RabbitMQ), so
# it runs as its own stack rather than inside this repo's compose file:
#   git clone https://github.com/firecrawl/firecrawl && cd firecrawl
#   cp .env.example .env   # USE_DB_AUTHENTICATION=false is fine for local use
#   docker compose up -d   # API listens on :3002 by default
# Not required unless /admin/scraper is actually used — scheduled and
# on-demand scrapes just fail closed with a clear error without it.
FIRECRAWL_API_URL="http://localhost:3002"
# Self-hosted Firecrawl accepts any non-empty bearer token unless it was
# started with USE_DB_AUTHENTICATION — leave as a placeholder in that case.
FIRECRAWL_API_KEY="local-dev"

# --- Wallet top-up (Paynow, Zimbabwe payment gateway) ---
# Covers both integration tiers, sharing the same credentials below:
#  - WEB REDIRECT (src/app/api/wallet/topup) — the user is redirected to
#    Paynow's hosted page, then back to NEXT_PUBLIC_SITE_URL/wallet/return.
#  - ADVANCED INTEGRATION / EXPRESS CHECKOUT (src/app/api/wallet/topup/express)
#    — charges a mobile money number (EcoCash/OneMoney/InnBucks) directly via
#    Paynow's API, no redirect; the customer authorizes on their phone.
# src/app/api/wallet/paynow/webhook is the actual source of truth for status
# in both flows (Paynow's "Result URL" — the browser return/poll alone isn't
# reliable). Get these from the Paynow merchant dashboard integration setup:
# https://www.paynow.co.zw — confirm with Paynow whether Express Checkout
# needs its own distinct integration ID/key or reuses the same one as web
# redirect. Sandbox/test-mode credentials are separate from live ones. Paynow
# issues a distinct integration (its own ID + key) per settlement currency, so
# USD and ZiG each need their own pair below — not required unless the wallet
# top-up feature is actually used, it just fails closed with a clear error
# without them.
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_INTEGRATION_ID_ZIG=
PAYNOW_INTEGRATION_KEY_ZIG=
