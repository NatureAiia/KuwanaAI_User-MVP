# Supabase's direct DB host (db.<ref>.supabase.co) is IPv6-only, which fails
# to connect on most networks. Use the Supavisor connection pooler instead
# (Project Settings > Database > Connection string > "Connection pooling"):
#   DATABASE_URL - transaction mode, port 6543, for app runtime queries
#   DIRECT_URL   - session mode, port 5432, required for `prisma migrate`
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Consumed by src/lib/supabase/admin.ts for the provider image-upload route
# (POST /api/provider/listings/images), which writes to Storage bypassing
# RLS — run supabase/storage-setup.sql once before this is usable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=sk-ant-xxx

# Comma-separated allowlist of emails granted admin access (src/lib/auth.ts requireAdmin).
ADMIN_EMAILS=admin@example.com

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET` when
# it calls src/app/api/cron/*. Set the same value in the Vercel project's env
# vars as CRON_SECRET (Vercel then attaches it automatically to cron
# requests — you don't wire the header yourself). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Canonical production URL, used by robots.ts/sitemap.ts (absolute URLs are
# required there). Falls back to localhost:3000 if unset — set this once a
# real domain is live.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Reported by /api/health. Set by the container build (--build-arg APP_VERSION)
# and by the Helm chart; harmless to leave unset locally.
APP_VERSION=dev
