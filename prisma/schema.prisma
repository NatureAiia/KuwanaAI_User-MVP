// Kuwana MVP — data model (see KUWANA_MVP_BUILD_PLAN.md Section 4 & 6)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model WaitlistSignup {
  id        String   @id @default(uuid())
  email     String
  sector    String // 'healthcare' for MVP; kept generic for future coming-soon sectors
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([email, sector])
  @@map("waitlist_signups")
}

// ---------------------------------------------------------------------------
// 4.1 Identity & onboarding
// ---------------------------------------------------------------------------

enum Role {
  consumer
  corporate
  regulator
  provider
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  role      Role     @default(consumer)
  createdAt DateTime @default(now()) @map("created_at")

  profile         UserProfile?
  footprints      SectorFootprint[]
  consents        Consent[]
  comparisons     Comparison[]
  savedListings   SavedListing[]
  recommendations Recommendation[]
  events          UserEvent[]
  xp              UserXp?
  badges          UserBadge[]
  questProgress   UserQuestProgress[]
  streak          UserStreak?
  notifications   Notification[]
  conversations   Conversation[]
  ownedProvider   Provider?

  @@map("users")
}

model UserProfile {
  userId          String   @id @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ageRange        String?  @map("age_range")
  occupation      String?
  location        String?
  fullName        String?  @map("full_name")
  nickname        String?
  socialPlatforms String[] @default([]) @map("social_platforms")

  @@map("user_profiles")
}

enum Sector {
  telecom
  banking
  insurance
  education
  healthcare
  transport
  utilities
  pharmacy
  electronics
  fashion
}

model SectorFootprint {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector Sector
  data   Json

  @@unique([userId, sector])
  @@map("sector_footprints")
}

model Consent {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentType String   @map("consent_type") // 'research_use' | 'leaderboard_participation'
  granted     Boolean
  grantedAt   DateTime @default(now()) @map("granted_at")

  @@unique([userId, consentType])
  // The leaderboard query filters exactly this combination to find every
  // opted-in user before joining against UserXp.
  @@index([consentType, granted])
  @@map("consents")
}

// ---------------------------------------------------------------------------
// 4.2 Sector catalog (schema-driven)
// ---------------------------------------------------------------------------

enum SectorStatus {
  live
  coming_soon
}

model SectorConfig {
  id     String       @id @default(uuid())
  name   String
  slug   String       @unique
  status SectorStatus @default(live)

  categories Category[]

  @@map("sectors")
}

model Category {
  id       String       @id @default(uuid())
  sectorId String       @map("sector_id")
  sector   SectorConfig @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  name     String
  slug     String

  attributeSchema AttributeSchemaField[]
  listings        Listing[]
  comparisons     Comparison[]

  @@unique([sectorId, slug])
  @@map("categories")
}

enum AttributeDataType {
  number
  string
  enum
  boolean
}

model AttributeSchemaField {
  id           String            @id @default(uuid())
  categoryId   String            @map("category_id")
  category     Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  key          String
  label        String
  dataType     AttributeDataType @map("data_type")
  unit         String?
  isComparable Boolean           @default(true) @map("is_comparable")
  sortOrder    Int               @default(0) @map("sort_order")

  @@unique([categoryId, key])
  @@map("attribute_schema")
}

model Provider {
  id          String  @id @default(uuid())
  name        String
  logoUrl     String? @map("logo_url")
  verified    Boolean @default(true)
  // Nullable: the ~15 seeded reference providers (CBZ, Econet, etc.) have no
  // login of their own — this is only set when a "provider" role account is
  // admin-linked to self-manage this provider's listings (see /provider,
  // /admin/users). SetNull rather than Cascade: deleting the linked user
  // account shouldn't delete the provider or its listings.
  ownerUserId String? @unique @map("owner_user_id")
  owner       User?   @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  listings Listing[]

  @@map("providers")
}

enum FreshnessStatus {
  fresh
  stale
  unverified
}

enum ListingStatus {
  draft
  pending_review
  published
  rejected
}

model Listing {
  id              String          @id @default(uuid())
  categoryId      String          @map("category_id")
  category        Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  providerId      String          @map("provider_id")
  provider        Provider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name            String
  attributes      Json
  price           Decimal         @db.Decimal(12, 2)
  currency        String          @default("USD")
  sourceUrl       String?         @map("source_url")
  images          String[]        @default([]) @map("images")
  lastVerifiedAt  DateTime        @default(now()) @map("last_verified_at")
  freshnessStatus FreshnessStatus @default(fresh) @map("freshness_status")
  // Provider self-submission workflow (build plan 15.2): draft -> pending_review
  // -> published/rejected. Defaults to "published" so every existing/admin-created
  // listing keeps behaving exactly as before — this workflow only applies to
  // listings a provider submits through /provider.
  status          ListingStatus   @default(published)
  rejectionReason String?         @map("rejection_reason")

  priceHistory    ListingPriceHistory[]
  savedBy         SavedListing[]
  recommendations Recommendation[]
  notifications   Notification[]

  // (categoryId, status, price): the consumer-facing hot path — every
  // catalog read filters this combination then orders by price
  // (getCategoryWithListings et al.). status alone: the admin review queue
  // filters by status with no categoryId, which can't use the composite
  // index's later columns without its first. providerId: the provider
  // portal's "my listings" query.
  @@index([categoryId, status, price])
  @@index([status])
  @@index([providerId])
  @@map("listings")
}

model ListingPriceHistory {
  id         String   @id @default(uuid())
  listingId  String   @map("listing_id")
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  price      Decimal  @db.Decimal(12, 2)
  recordedAt DateTime @default(now()) @map("recorded_at")

  // computePriceTrend/computePriceForecast read a listing's full history
  // ordered by time — this is the exact access pattern.
  @@index([listingId, recordedAt])
  @@map("listing_price_history")
}

// ---------------------------------------------------------------------------
// 4.3 User comparison activity
// ---------------------------------------------------------------------------

model Comparison {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  listingIds String[] @map("listing_ids")
  createdAt  DateTime @default(now()) @map("created_at")

  // Every quest-progress check (category_count/comparison_count/
  // sector_diversity criteria) queries exactly userId + a createdAt range,
  // on every comparison_completed event.
  @@index([userId, createdAt(sort: Desc)])
  // getAlsoCompared's `listingIds: { has: listingId }` is an array-
  // containment query — a GIN index is the correct index type for that,
  // not a btree.
  @@index([listingIds], type: Gin)
  @@map("comparisons")
}

model SavedListing {
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String   @map("listing_id")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  savedAt   DateTime @default(now()) @map("saved_at")

  @@id([userId, listingId])
  // The PK above already covers a plain userId filter (leftmost prefix),
  // but the saved-listings page also orders by savedAt (most recent
  // first) — a separate index matching that exact order avoids an
  // in-memory sort.
  @@index([userId, savedAt(sort: Desc)])
  @@map("saved_listings")
}

model Recommendation {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId    String   @map("listing_id")
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  explanation  String
  confidence   Decimal  @db.Decimal(4, 3)
  scoreVersion String   @default("v1") @map("score_version")
  generatedAt  DateTime @default(now()) @map("generated_at")

  @@index([listingId])
  @@index([userId, generatedAt(sort: Desc)])
  @@map("recommendations")
}

enum NotificationType {
  price_drop
  listing_approved
  listing_rejected
}

model Notification {
  id            String           @id @default(uuid())
  userId        String           @map("user_id")
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId     String           @map("listing_id")
  listing       Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  type          NotificationType @default(price_drop)
  message       String
  // Only meaningful for price_drop; null for listing_approved/listing_rejected.
  changePercent Float?           @map("change_percent")
  read          Boolean          @default(false)
  createdAt     DateTime         @default(now()) @map("created_at")

  @@unique([userId, listingId, type])
  @@index([listingId])
  @@index([userId, read, createdAt(sort: Desc)])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// 4.4 AI chat assistant
// ---------------------------------------------------------------------------

enum ChatRole {
  user
  assistant
}

model Conversation {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now()) @map("created_at")
  lastMessageAt DateTime @default(now()) @map("last_message_at")

  messages Message[]

  @@index([userId, createdAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ChatRole
  content        String
  listingIds     String[]     @default([]) @map("listing_ids")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// 6. Gamification
// ---------------------------------------------------------------------------

enum EventType {
  profile_completed
  comparison_viewed
  comparison_completed
  recommendation_viewed
  item_saved
  action_taken
  daily_visit
  chat_started
}

model UserEvent {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector    Sector?
  eventType EventType @map("event_type")
  metadata  Json?
  createdAt DateTime  @default(now()) @map("created_at")

  // Every badge-trigger check (event_count_in_sector/distinct_sector_count)
  // queries exactly this combination, on every qualifying event.
  @@index([userId, eventType, createdAt(sort: Desc)])
  @@map("user_events")
}

model GamificationRule {
  eventType    EventType @id @map("event_type")
  xpValue      Int       @map("xp_value")
  badgeTrigger Json?     @map("badge_trigger")
  questTrigger Json?     @map("quest_trigger")

  @@map("gamification_rules")
}

model UserXp {
  userId  String @id @map("user_id")
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalXp Int    @default(0) @map("total_xp")
  level   Int    @default(1)

  // The leaderboard's ORDER BY totalXp DESC.
  @@index([totalXp(sort: Desc)])
  @@map("user_xp")
}

model Badge {
  id          String @id @default(uuid())
  name        String @unique
  description String
  criteria    Json

  users UserBadge[]

  @@map("badges")
}

model UserBadge {
  userId   String   @map("user_id")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId  String   @map("badge_id")
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt DateTime @default(now()) @map("earned_at")

  @@id([userId, badgeId])
  @@map("user_badges")
}

model Quest {
  id          String   @id @default(uuid())
  name        String
  description String
  criteria    Json
  activeFrom  DateTime @map("active_from")
  activeTo    DateTime @map("active_to")

  progress UserQuestProgress[]

  // quest-rotation checks "is anything active right now" via activeTo.
  @@index([activeTo])
  @@map("quests")
}

model UserQuestProgress {
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId     String    @map("quest_id")
  quest       Quest     @relation(fields: [questId], references: [id], onDelete: Cascade)
  progress    Int       @default(0)
  completedAt DateTime? @map("completed_at")

  @@id([userId, questId])
  @@map("user_quest_progress")
}

model UserStreak {
  userId         String    @id @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak  Int       @default(0) @map("current_streak")
  longestStreak  Int       @default(0) @map("longest_streak")
  lastActiveDate DateTime? @map("last_active_date") @db.Date

  @@map("user_streaks")
}

enum SocialPlatform {
  telegram
  reddit
}

/// A public social post mentioning a price, found by the free social-media
/// price scanner (see scripts/social-scan). Read-only intelligence feed —
/// never shown to end users directly, reviewed by an admin before any
/// listing/price data is acted on.
model SocialPriceMention {
  id              String         @id @default(uuid())
  platform        SocialPlatform
  channel         String // Telegram channel username, or subreddit name
  sourceUrl       String         @map("source_url")
  postedAt        DateTime?      @map("posted_at")
  discoveredAt    DateTime       @default(now()) @map("discovered_at")
  text            String
  matchedProvider String?        @map("matched_provider")
  extractedPrices Json           @map("extracted_prices") // ExtractedPrice[]
  reviewed        Boolean        @default(false)

  @@unique([platform, sourceUrl])
  @@index([matchedProvider])
  // The admin review queue's reviewed/unreviewed toggle, newest first.
  @@index([reviewed, discoveredAt(sort: Desc)])
  @@map("social_price_mentions")
}

/// Live FX reference rates (units per 1 USD), refreshed by
/// scripts/fx-refresh — overrides the static, hand-maintained defaults in
/// lib/currency.ts wherever a live rate exists. `code` matches
/// CurrencyCode ("ZiG"/"ZAR"/"GBP") even though the upstream source uses
/// ISO codes (ZWG for ZiG) — the refresh script maps between them.
model FxRate {
  code      String   @id
  perUsd    Float    @map("per_usd")
  source    String
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@map("fx_rates")
}

enum AdminAuditAction {
  listing_approved
  listing_rejected
  listing_deleted
  provider_linked
  provider_unlinked
  user_role_changed
}

// No FK relations to the acted-on row — an audit log needs to survive the
// row it's about being deleted (e.g. listing_deleted), which a Cascade
// would defeat and a SetNull would silently blank out.
model AdminAuditLog {
  id         String           @id @default(uuid())
  adminEmail String           @map("admin_email")
  action     AdminAuditAction
  targetType String           @map("target_type") // "listing" | "provider" | "user"
  targetId   String           @map("target_id")
  detail     String
  createdAt  DateTime         @default(now()) @map("created_at")

  // The admin audit page reads newest-first with no other filter.
  @@index([createdAt(sort: Desc)])
  @@map("admin_audit_log")
}

// Backs rate limiting on public unauthenticated endpoints (/api/waitlist,
// /api/need-intake) without needing new infra (Redis/Upstash) — this app
// deploys to Vercel (see vercel.json), where an in-memory counter wouldn't
// reliably survive across serverless invocations, but Postgres already does.
// Self-cleaning: checkRateLimit deletes a key's own expired hits on every
// call, so this never needs a separate cron sweep.
model RateLimitHit {
  id        String   @id @default(uuid())
  key       String // e.g. "need-intake:203.0.113.5"
  createdAt DateTime @default(now()) @map("created_at")

  @@index([key, createdAt])
  @@map("rate_limit_hits")
}

// Caches /api/recommendations' Claude output per distinct listing-set (not
// per-user — the recommendation is a pure function of the listing set, the
// route doesn't factor in the caller's footprint). Comparing the same 2-3
// listings repeatedly is common while a user is deciding; this skips the
// re-bill on a cache hit. Deliberately separate from the Recommendation
// table, which stays the audit-grade "this user got this recommendation at
// this time" record and is still written on every request, cache hit or not.
model RecommendationCache {
  cacheKey  String   @id @map("cache_key")
  payload   Json
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("recommendation_cache")
}
