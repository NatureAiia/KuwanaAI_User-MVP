enum SocialPlatform {
  telegram
  reddit
}

enum SentimentLabel {
  positive
  negative
  neutral
}

/// A public social post mentioning a price, found by the free social-media
/// price scanner (see scripts/social-scan). Read-only intelligence feed —
/// never shown to end users directly, reviewed by an admin before any
/// listing/price data is acted on.
model SocialPriceMention {
  id              String          @id @default(uuid())
  platform        SocialPlatform
  channel         String // Telegram channel username, or subreddit name
  sourceUrl       String          @map("source_url")
  postedAt        DateTime?       @map("posted_at")
  discoveredAt    DateTime        @default(now()) @map("discovered_at")
  text            String
  matchedProvider String?         @map("matched_provider")
  extractedPrices Json            @map("extracted_prices") // ExtractedPrice[]
  reviewed        Boolean         @default(false)
  // Null = not yet classified. Computed lazily (see lib/sentiment.ts) rather
  // than at scan time, so the scanner script stays free of an AI-provider
  // dependency — the same "compute on read, persist" shape as
  // syncPriceDropNotifications and friends.
  sentiment       SentimentLabel? @map("sentiment")

  @@unique([platform, sourceUrl])
  @@index([matchedProvider])
  // The admin review queue's reviewed/unreviewed toggle, newest first.
  @@index([reviewed, discoveredAt(sort: Desc)])
  @@map("social_price_mentions")
}

enum ScrapeTrigger {
  cron
  admin_manual
}

/// A provider page an admin wants crawled periodically for pricing (see
/// scripts/scrape, /admin/scraper). Distinct from SocialPriceMention's free
/// social scan — this targets known provider/regulator URLs on a schedule.
model ScrapeSource {
  id         String    @id @default(uuid())
  name       String
  url        String
  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  enabled    Boolean   @default(true)
  lastRunAt  DateTime? @map("last_run_at")
  lastError  String?   @map("last_error")
  createdAt  DateTime  @default(now()) @map("created_at")

  items ScrapedItem[]

  @@index([enabled])
  @@map("scrape_sources")
}

enum ScrapeItemStatus {
  pending
  approved
  rejected
}

/// A candidate listing extracted from a scraped/searched page, awaiting
/// admin review — never written to Listing directly. See
/// /admin/scraper and src/app/api/admin/scraped-items.
model ScrapedItem {
  id                  String           @id @default(uuid())
  sourceId            String?          @map("source_id")
  source              ScrapeSource?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  // Carried alongside sourceId (from ScrapeSource.categoryId) or set directly
  // on an admin-search hit — the only categorization ScrapedItem has, needed
  // to create a Listing on approval when there's no suggestedListingId.
  categoryId          String?          @map("category_id")
  category            Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sourceUrl           String           @map("source_url")
  triggeredBy         ScrapeTrigger    @map("triggered_by")
  // Firecrawl markdown snapshot of the page at fetch time — kept so an admin
  // can see exactly what the extraction was based on, not just its output.
  rawContent          String           @map("raw_content")
  // Candidate listing fields: {name, price, currency, description, attributes, providerNameGuess, categorySlug}
  extractedData       Json             @map("extracted_data")
  confidence          Float
  suggestedProviderId String?          @map("suggested_provider_id")
  suggestedProvider   Provider?        @relation(fields: [suggestedProviderId], references: [id], onDelete: SetNull)
  suggestedListingId  String?          @map("suggested_listing_id")
  suggestedListing    Listing?         @relation(fields: [suggestedListingId], references: [id], onDelete: SetNull)
  status              ScrapeItemStatus @default(pending)
  reviewedByEmail     String?          @map("reviewed_by_email")
  reviewedAt          DateTime?        @map("reviewed_at")
  rejectionReason     String?          @map("rejection_reason")
  discoveredAt        DateTime         @default(now()) @map("discovered_at")

  // The admin review queue's status filter, newest first.
  @@index([status, discoveredAt(sort: Desc)])
  @@index([sourceId])
  @@map("scraped_items")
}

/// Live FX reference rates (units per 1 USD), refreshed by
/// scripts/fx-refresh — overrides the static, hand-maintained defaults in
/// lib/currency.ts wherever a live rate exists. `code` matches
/// CurrencyCode ("ZiG"/"ZAR"/"GBP") even though the upstream source uses
/// ISO codes (ZWG for ZiG) — the refresh script maps between them.
model FxRate {
  code      String   @id
  perUsd    Float    @map("per_usd")
  source    String
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@map("fx_rates")
}

enum AdminAuditAction {
  listing_approved
  listing_rejected
  listing_deleted
  provider_linked
  provider_unlinked
  user_role_changed
  llm_model_changed
  scrape_item_approved
  scrape_item_rejected
  scrape_source_created
  advert_created
  advert_updated
  advert_deleted
  corporate_request_approved
  corporate_request_rejected
  corporate_domain_linked
  discount_rule_created
  discount_rule_deleted
  economic_driver_upserted
  economic_driver_deleted
  business_condition_created
  business_condition_updated
  business_condition_deleted
  api_key_created
  api_key_revoked
  listing_created
  provider_created
  scrape_source_updated
  scrape_source_deleted
  social_mention_reviewed
  market_basket_item_created
  market_basket_item_deleted
  investigation_flagged
  investigation_updated
  price_cap_rule_created
  price_cap_rule_updated
  price_cap_rule_deleted
  complaint_promoted
  user_suspended
  user_reactivated
  provider_listings_removed
}

// No FK relations to the acted-on row — an audit log needs to survive the
// row it's about being deleted (e.g. listing_deleted), which a Cascade
// would defeat and a SetNull would silently blank out.
model AdminAuditLog {
  id         String           @id @default(uuid())
  adminEmail String           @map("admin_email")
  action     AdminAuditAction
  targetType String           @map("target_type") // "listing" | "provider" | "user"
  targetId   String           @map("target_id")
  detail     String
  createdAt  DateTime         @default(now()) @map("created_at")

  // The admin audit page reads newest-first with no other filter.
  @@index([createdAt(sort: Desc)])
  @@map("admin_audit_log")
}

// Backs rate limiting on public unauthenticated endpoints (/api/waitlist,
// /api/need-intake) without needing new infra (Redis/Upstash) — this app
// deploys to Vercel (see vercel.json), where an in-memory counter wouldn't
// reliably survive across serverless invocations, but Postgres already does.
// Self-cleaning: checkRateLimit deletes a key's own expired hits on every
// call, so this never needs a separate cron sweep.
model RateLimitHit {
  id        String   @id @default(uuid())
  key       String // e.g. "need-intake:203.0.113.5"
  createdAt DateTime @default(now()) @map("created_at")

  @@index([key, createdAt])
  @@map("rate_limit_hits")
}

// Caches /api/recommendations' Claude output per distinct listing-set (not
// per-user — the recommendation is a pure function of the listing set, the
// route doesn't factor in the caller's footprint). Comparing the same 2-3
// listings repeatedly is common while a user is deciding; this skips the
// re-bill on a cache hit. Deliberately separate from the Recommendation
// table, which stays the audit-grade "this user got this recommendation at
// this time" record and is still written on every request, cache hit or not.
model RecommendationCache {
  cacheKey  String   @id @map("cache_key")
  payload   Json
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("recommendation_cache")
}

// ---------------------------------------------------------------------------
// LLM routing & cost tracking
// ---------------------------------------------------------------------------

// One row per model call, written by lib/ai/provider.ts on both success and
// failure. Failures are recorded too: a route that starts erroring is the
// thing an admin most needs to see on the cost page, and a table that only
// holds successes makes an outage look like a traffic drop.
//
// Cost is stored per row rather than derived at read time from a price table
// — prices change, and a historical row must keep the cost it was actually
// billed at. Decimal, not Float: at $0.00000008/token a float's rounding
// error is a meaningful share of the value.
model LlmUsage {
  id           String  @id @default(uuid())
  provider     String // "anthropic" | "openrouter"
  model        String
  feature      String // "chat" | "recommendations" | "intake"
  userId       String? @map("user_id")
  inputTokens  Int     @default(0) @map("input_tokens")
  outputTokens Int     @default(0) @map("output_tokens")
  costUsd      Decimal @default(0) @map("cost_usd") @db.Decimal(14, 10)
  latencyMs    Int     @map("latency_ms")
  ok           Boolean @default(true)
  errorMessage String? @map("error_message")

  // Tier routing. `attempt` is 1 for the rung the complexity heuristic chose
  // and increments each time a failure pushed the call further up the ladder,
  // so "escalation rate" is just the share of rows with attempt > 1.
  // `complexity` is stored so the heuristics in lib/ai/tiers.ts can be re-tuned
  // later against what actually happened rather than from intuition.
  attempt       Int     @default(1)
  escalatedFrom String? @map("escalated_from")
  complexity    Float?

  createdAt DateTime @default(now()) @map("created_at")

  // No FK to User: usage is an operational record that must outlive the
  // account that generated it, the same reasoning as admin_audit_log.
  @@index([createdAt(sort: Desc)])
  @@index([feature, createdAt])
  @@index([model, createdAt])
  @@map("llm_usage")
}

// Small key/value store for operator-tunable runtime settings. Currently only
// the per-feature model selection (`llm.model.<feature>`), which admins change
// from /admin/llm without a redeploy.
model AppSetting {
  key       String   @id
  value     String
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// Admin-managed promo slots rotated through the explore page's ad card.
model Advert {
  id          String   @id @default(uuid())
  sponsorName String   @map("sponsor_name")
  tagline     String
  imageUrl    String   @map("image_url")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([active])
  @@map("adverts")
}

// ---------------------------------------------------------------------------
// Corporate pricing intelligence, governance & sentiment (Kuwana for
// Business feature expansion — see wobbly-prancing-sky.md plan)
// ---------------------------------------------------------------------------

enum DiscountScope {
  category
  listing
}

// A corporate-configured percentage markdown, applied at category or
// single-listing granularity. Applying a rule writes a normal
// ListingPriceHistory row (see lib/discounts.ts), so an active discount
// surfaces through the existing price-drop notification path for free —
// this table is the rule + its own history (query by providerId, newest
// first), not a separate "discount history" model.
model DiscountRule {
  id              String        @id @default(uuid())
  providerId      String        @map("provider_id")
  provider        Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  scope           DiscountScope
  categoryId      String?       @map("category_id")
  category        Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  listingId       String?       @map("listing_id")
  listing         Listing?      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  percentOff      Decimal       @map("percent_off") @db.Decimal(5, 2)
  startsAt        DateTime      @map("starts_at")
  endsAt          DateTime      @map("ends_at")
  createdByUserId String        @map("created_by_user_id")
  createdBy       User          @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([providerId, createdAt(sort: Desc)])
  @@index([listingId])
  @@map("discount_rules")
}

// Global macro indicator values (inflation, FX, interest rates), admin
// managed at /admin/economic-drivers — not per-corporate, every account
// reads the same rows. `period` is the month a value applies to.
model EconomicDriver {
  id             String   @id @default(uuid())
  name           String
  region         String   @default("ZW")
  value          Decimal  @db.Decimal(10, 4)
  previousValue  Decimal? @map("previous_value") @db.Decimal(10, 4)
  period         DateTime @db.Date
  currencyCode   String?  @map("currency_code")
  updatedByEmail String?  @map("updated_by_email")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([name, region, period])
  @@index([period(sort: Desc)])
  @@map("economic_drivers")
}

/// One representative good/service tracked as part of a named cost-of-living
/// basket (e.g. "Consumer Price Basket" -> 10kg mealie-meal, diesel, data
/// bundle...) — admin-curated, same "reference data an admin maintains"
/// pattern as EconomicDriver/BusinessCondition. The basket's index value
/// itself stays computed-on-read from each component's ListingPriceHistory
/// (see getBasketIndexTrend in lib/marketBasket.ts) rather than a separate
/// stored index table, matching how every other trend in this app works.
model MarketBasketItem {
  id         String   @id @default(uuid())
  basketName String   @map("basket_name")
  label      String
  listingId  String   @map("listing_id")
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  weight     Decimal  @default(1) @db.Decimal(6, 3)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([basketName, listingId])
  @@index([basketName])
  @@map("market_basket_items")
}

enum BusinessConditionCategory {
  regulatory
  competitor
  macro
}

enum RiskLevel {
  low
  medium
  high
}

// A tracked regulatory change, competitor move, or macro trigger that could
// affect pricing — managed by admin/regulator at /admin/business-conditions,
// surfaced read-only on /regulator and /corporate. documentUrls is a plain
// URL list rather than a separate documents table/model: no file-upload
// infra exists anywhere in this app yet, so this starts URL-only.
model BusinessCondition {
  id               String                    @id @default(uuid())
  title            String
  category         BusinessConditionCategory
  riskLevel        RiskLevel                 @default(medium) @map("risk_level")
  reviewCycleDays  Int?                      @map("review_cycle_days")
  notes            String?
  documentUrls     String[]                  @default([]) @map("document_urls")
  sectorSlug       String?                   @map("sector_slug")
  assignedToUserId String?                   @map("assigned_to_user_id")
  assignedTo       User?                     @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  notifications    Notification[]

  @@index([category])
  @@index([riskLevel])
  @@map("business_conditions")
}

enum AlertMetric {
  avg_price
  listing_count
  trending_down
  trending_up
  unverified_count
}

enum AlertDirection {
  above
  below
}

// A corporate-configured threshold that, when crossed, writes a Notification
// (extends NotificationType rather than a parallel delivery system — see
// lib/alerts.ts). One row per metric/threshold, evaluated on read (no cron
// yet — matches how syncPriceDropNotifications() runs on page load today).
model AlertRule {
  id              String         @id @default(uuid())
  providerId      String         @map("provider_id")
  provider        Provider       @relation(fields: [providerId], references: [id], onDelete: Cascade)
  metric          AlertMetric
  threshold       Decimal        @db.Decimal(12, 2)
  direction       AlertDirection
  enabled         Boolean        @default(true)
  createdByUserId String         @map("created_by_user_id")
  createdBy       User           @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now()) @map("created_at")
  notifications   Notification[]

  @@index([providerId])
  @@map("alert_rules")
}

/// A gazetted price ceiling for a category — sector/category-wide, unlike
/// AlertRule (which is always scoped to one provider's own metrics). A
/// regulator sets this once per category; getPriceCapBreaches() flags every
/// currently-published listing in that category priced above it, in the
/// rule's own currency (no FX conversion — a cap only ever compares like for
/// like).
model PriceCapRule {
  id              String         @id @default(uuid())
  categoryId      String         @map("category_id")
  category        Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  capValue        Decimal        @map("cap_value") @db.Decimal(12, 2)
  currency        String         @default("USD")
  enabled         Boolean        @default(true)
  createdByUserId String         @map("created_by_user_id")
  createdBy       User           @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now()) @map("created_at")
  notifications   Notification[]

  @@index([categoryId])
  @@map("price_cap_rules")
}

// Per-user, per-notification-type delivery preference. `channel` is always
// "inapp" for now — email/SMS have no delivery infra anywhere in this app,
// so the column exists for forward compatibility rather than active use.
model NotificationPreference {
  userId  String           @map("user_id")
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    NotificationType
  channel String           @default("inapp")
  enabled Boolean          @default(true)

  @@id([userId, type, channel])
  @@map("notification_preferences")
}

// API-key-secured access for external BI tools (see /api/bi/*). No FK-joined
// "usage log" table — lastUsedAt is enough for this app's scale, matching
// how RateLimitHit above keeps things minimal.
model ApiKey {
  id         String    @id @default(uuid())
  providerId String?   @map("provider_id")
  provider   Provider? @relation(fields: [providerId], references: [id], onDelete: Cascade)
  label      String
  hashedKey  String    @unique @map("hashed_key")
  scopes     String[]  @default([])
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  @@index([providerId])
  @@map("api_keys")
}

enum ChatFeedbackRating {
  up
  down
}

model ChatFeedback {
  id        String             @id @default(uuid())
  messageId String             @map("message_id")
  message   Message            @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String             @map("user_id")
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    ChatFeedbackRating
  comment   String?
  createdAt DateTime           @default(now()) @map("created_at")

  @@unique([messageId, userId])
  @@map("chat_feedback")
}

// ---------------------------------------------------------------------------
// Subscription plans & entitlement (per-portal, monthly billing period)
// ---------------------------------------------------------------------------

/// A per-portal subscription tier (one catalog per Role via `role`, since
/// consumer/corporate/regulator pricing will diverge — consumer stays
/// self-service/freemium, corporate and regulator are subscription-only).
/// Every plan is currently priceCents: 0 with empty `features` (= full
/// access, same convention as User.allowedFeatures below) while the
/// business model/packages aren't decided yet — see lib/subscriptions.ts,
/// which seeds the canonical "<role>_free" plan for each portal on read
/// rather than requiring a manual data migration.
model Plan {
  id                  String        @id @default(uuid())
  key                 String        @unique
  role                Role
  name                String
  priceCents          Int           @default(0) @map("price_cents")
  currency            TopUpCurrency @default(USD)
  billingPeriodMonths Int           @default(1) @map("billing_period_months")
  features            String[]      @default([])
  isActive            Boolean       @default(true) @map("is_active")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

/// One row per user (1:1, like UserXp/UserStreak) tracking their current
/// plan and billing period. Auto-provisioned onto the free plan for their
/// role the first time getOrCreateSubscription/ensureAllSubscriptions runs
/// (see lib/subscriptions.ts) rather than at signup — this app has no
/// single app-level signup hook (see link_users_to_auth_via_triggers), so
/// self-healing on read is the same "compute on read, persist" shape as
/// FxRate/RecommendationCache elsewhere in this file.
model Subscription {
  id                 String   @id @default(uuid())
  userId             String   @unique @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId             String   @map("plan_id")
  plan               Plan     @relation(fields: [planId], references: [id])
  currentPeriodStart DateTime @map("current_period_start")
  currentPeriodEnd   DateTime @map("current_period_end")
  autoRenew          Boolean  @default(true) @map("auto_renew")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // The reset cron's "find everything due" query.
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Wallet top-up (Paynow, Zimbabwe payment gateway — web redirect flow)
// ---------------------------------------------------------------------------

enum TopUpStatus {
  initiated
  pending
  paid
  cancelled
  failed
  refunded
}

enum TopUpCurrency {
  USD
  ZiG
}

/// One row per wallet top-up attempt via Paynow's WEB REDIRECT flow. Single
/// mutable row updated in place as status progresses (initiated -> pending ->
/// paid/cancelled/failed) — this *is* the primary entity, so unlike
/// AdminAuditLog/ListingUpdateLog there's no separate "current state lives
/// elsewhere" row for an append-only log to supplement. paynowStatus keeps
/// Paynow's raw response string verbatim so a value our TopUpStatus enum
/// doesn't yet model is never silently dropped. See src/lib/paynow.ts and
/// src/app/api/wallet/*.
model WalletTransaction {
  id              String        @id @default(uuid())
  userId          String        @map("user_id")
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Sent to Paynow as `reference` — must be unique per attempt, since Paynow
  // requires a fresh reference per initiate call (reusing one produces
  // ambiguous poll/webhook matching).
  reference       String        @unique
  amount          Decimal       @db.Decimal(12, 2)
  currency        TopUpCurrency @default(USD)
  status          TopUpStatus   @default(initiated)
  // Paynow's own reference, only known after a successful initiate call.
  paynowReference String?       @map("paynow_reference")
  // Paynow's poll URL — used by the return-page poll fallback if the webhook
  // hasn't landed yet.
  pollUrl         String?       @map("poll_url")
  paynowStatus    String?       @map("paynow_status")
  failureReason   String?       @map("failure_reason")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // The user-facing top-up history read.
  @@index([userId, createdAt(sort: Desc)])
  // The admin transactions view's status filter, newest first.
  @@index([status, createdAt(sort: Desc)])
  @@map("wallet_transactions")
}

enum InvestigationStatus {
  open
  in_progress
  resolved
  dismissed
}

// The enforcement action a regulator recorded on closing a case — distinct
// from InvestigationStatus (which just tracks workflow state) because a
// corporate-initiated self-flag never has one; it stays "none" until a
// regulator account resolves it with a real action taken.
enum InvestigationOutcome {
  none
  warning
  fine
  suspension
}

/// Case-tracking for a flagged listing, opened either by a corporate account
/// self-flagging its own listing (self-service pricing-integrity workflow)
/// or by a regulator account investigating any provider (enforcement
/// workflow — see /regulator/investigations). Anomalies themselves stay
/// computed-on-read (getProviderFeeComparison / getSectorPricingSummary);
/// this is only the workflow state layered on top once someone decides a
/// flagged listing is worth tracking.
model ListingInvestigation {
  id               String               @id @default(uuid())
  // Nullable + SetNull (not the original Cascade): an admin's "permanent"
  // account deactivation hard-deletes a provider's listings (see
  // api/admin/users/[id]/route.ts), and a case's enforcement outcome
  // (warning/fine/suspension) must outlive the listing it was about — the
  // same reasoning AdminAuditLog already documents for its own rows.
  listingId        String?              @map("listing_id")
  listing          Listing?             @relation(fields: [listingId], references: [id], onDelete: SetNull)
  // Snapshot of the listing's name at creation time, so it still displays
  // sensibly after the listing above is gone — same "kept even if the
  // underlying thing changes later" reasoning as `reason` below.
  listingName      String               @map("listing_name")
  providerId       String               @map("provider_id")
  provider         Provider             @relation(fields: [providerId], references: [id], onDelete: Cascade)
  // Snapshot of why this was flagged at creation time (e.g. "z-score 2.4,
  // 18% below category peer median") — kept even if the underlying price
  // changes later and the listing stops being an outlier.
  reason           String
  status           InvestigationStatus  @default(open)
  assignedToUserId String?              @map("assigned_to_user_id")
  assignedTo       User?                @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)
  notes            String?
  // Only ever set by a regulator closing a case with a real enforcement
  // action; stays "none" for corporate self-flagged investigations.
  outcome          InvestigationOutcome @default(none)
  // Supporting documents/screenshots a regulator attaches to a case — a
  // plain URL list rather than a separate documents table/model, matching
  // BusinessCondition.documentUrls (no file-upload infra exists yet).
  evidenceUrls     String[]             @default([]) @map("evidence_urls")
  createdAt        DateTime             @default(now()) @map("created_at")
  resolvedAt       DateTime?            @map("resolved_at")

  originatingComplaints ConsumerComplaint[]

  @@index([providerId, status])
  @@index([listingId])
  @@map("listing_investigations")
}

enum ComplaintStatus {
  open
  reviewing
  resolved
  dismissed
}

/// A consumer-reported price/service issue — the "report a price" hotline a
/// real price regulator relies on for most of its leads, distinct from
/// ListingInvestigation (which is a regulator/corporate-opened case, not a
/// public submission). Requires a logged-in consumer account: no anonymous
/// submission, so a complaint always ties back to a real user and gets
/// spam/abuse protection for free from the existing auth system rather than
/// needing its own (no CAPTCHA/rate-limit infra exists in this app yet).
model ConsumerComplaint {
  id                    String                @id @default(uuid())
  userId                String                @map("user_id")
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Nullable: a complaint can be general ("this shop is overcharging") rather
  // than tied to one specific listing.
  listingId             String?               @map("listing_id")
  listing               Listing?              @relation(fields: [listingId], references: [id], onDelete: SetNull)
  description           String
  status                ComplaintStatus       @default(open)
  // Set once a regulator promotes this complaint into a real case — SetNull
  // (not Cascade) so deleting the investigation doesn't also delete the
  // complaint that led to it.
  linkedInvestigationId String?               @map("linked_investigation_id")
  linkedInvestigation   ListingInvestigation? @relation(fields: [linkedInvestigationId], references: [id], onDelete: SetNull)
  createdAt             DateTime              @default(now()) @map("created_at")

  @@index([status, createdAt(sort: Desc)])
  @@index([listingId])
  @@map("consumer_complaints")
}

enum AdminAlertMetric {
  total_providers
  published_listings
  pending_review_listings
  open_investigations
  pending_corporate_requests
}

/// Admin's counterpart to AlertRule — same threshold-crossing shape (see
/// lib/alerts.ts) but every metric is a platform-wide count rather than one
/// provider's own listings, so it isn't scoped by providerId. Evaluated live
/// on read, same as AlertRule (no cron yet); kept as its own model instead of
/// making AlertRule.providerId nullable, since every other AlertRule query
/// in this codebase assumes a real provider.
model AdminAlertRule {
  id              String           @id @default(uuid())
  metric          AdminAlertMetric
  threshold       Decimal          @db.Decimal(12, 2)
  direction       AlertDirection
  enabled         Boolean          @default(true)
  createdByUserId String           @map("created_by_user_id")
  createdBy       User             @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now()) @map("created_at")

  @@map("admin_alert_rules")
}
