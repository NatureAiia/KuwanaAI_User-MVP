// Kuwana MVP — data model (see KUWANA_MVP_BUILD_PLAN.md Section 4 & 6)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model WaitlistSignup {
  id        String   @id @default(uuid())
  email     String
  sector    String // 'healthcare' for MVP; kept generic for future coming-soon sectors
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([email, sector])
  @@map("waitlist_signups")
}

// ---------------------------------------------------------------------------
// 4.1 Identity & onboarding
// ---------------------------------------------------------------------------

enum Role {
  consumer
  corporate
  regulator
  provider
  admin
}

enum AccountStatus {
  active
  suspended
}

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  // The user-facing unique handle captured at signup (replaces the old free-text
  // "full name" field) — doubles as a stable, human-picked identifier alongside `id`.
  username               String    @unique
  role                   Role      @default(consumer)
  createdAt              DateTime  @default(now()) @map("created_at")
  // Admin-only kill switch (see requireUser() in lib/auth.ts, the single
  // choke point almost every page/route calls through) — a suspended
  // account is blocked everywhere immediately, not just re-gated at login.
  accountStatus          AccountStatus @default(active) @map("account_status")
  suspendedAt            DateTime? @map("suspended_at")
  suspendedReason        String?   @map("suspended_reason")
  // Grants access to specific gated sub-features regardless of role (e.g.
  // corporate feature keys) — empty means "full access for this role", the
  // same fallback semantics as coarse role checks everywhere else in this
  // file. Feature keys are plain strings defined where they're checked, not
  // as an enum, so a new gated feature never needs a migration.
  allowedFeatures        String[]  @default([]) @map("allowed_features")
  // Spendable wallet balances, credited by a webhook when a WalletTransaction
  // flips to paid (see WalletTransaction below) — one field per supported
  // top-up currency rather than a generic multi-currency Wallet model, since
  // Paynow only ever settles in USD or ZiG for this integration.
  walletBalanceUsd       Decimal   @default(0) @map("wallet_balance_usd") @db.Decimal(12, 2)
  walletBalanceZig       Decimal   @default(0) @map("wallet_balance_zig") @db.Decimal(12, 2)
  // Set at signup for corporate accounts — which industry they operate in, so
  // Market Intelligence/business conditions can default to their own market
  // instead of an unfiltered all-sectors view. Not meaningful for other roles.
  primarySector          Sector?   @map("primary_sector")
  // Cooldown gate for the price-drop notification sync (see
  // api/notifications/route.ts) — persisted rather than in-memory because
  // this app deploys on Vercel (see vercel.json), where a request can land
  // on any warm instance and an in-process Map isn't reliably shared.
  lastNotificationSyncAt DateTime? @map("last_notification_sync_at")

  profile                 UserProfile?
  footprints              SectorFootprint[]
  consents                Consent[]
  comparisons             Comparison[]
  savedListings           SavedListing[]
  pinnedListings          PinnedListing[]
  recommendations         Recommendation[]
  events                  UserEvent[]
  xp                      UserXp?
  badges                  UserBadge[]
  questProgress           UserQuestProgress[]
  streak                  UserStreak?
  notifications           Notification[]
  conversations           Conversation[]
  ownedProvider           Provider?
  corporateRequests       CorporateRequest[]
  discountRulesCreated    DiscountRule[]
  alertRulesCreated       AlertRule[]
  assignedConditions      BusinessCondition[]
  notificationPreferences NotificationPreference[]
  chatFeedback            ChatFeedback[]
  walletTransactions      WalletTransaction[]
  assignedInvestigations  ListingInvestigation[]
  priceCapRulesCreated    PriceCapRule[]
  complaints              ConsumerComplaint[]
  adminAlertRulesCreated  AdminAlertRule[]

  @@map("users")
}

model UserProfile {
  userId          String   @id @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ageRange        String?  @map("age_range")
  occupation      String?
  location        String?
  fullName        String?  @map("full_name")
  nickname        String?
  socialPlatforms String[] @default([]) @map("social_platforms")

  @@map("user_profiles")
}

enum Sector {
  telecom
  banking
  insurance
  education
  healthcare
  transport
  utilities
  pharmacy
  electronics
  fashion
  hotels
  retail
}

model SectorFootprint {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector Sector
  data   Json

  @@unique([userId, sector])
  @@map("sector_footprints")
}

model Consent {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentType String   @map("consent_type") // 'research_use' | 'leaderboard_participation'
  granted     Boolean
  grantedAt   DateTime @default(now()) @map("granted_at")

  @@unique([userId, consentType])
  // The leaderboard query filters exactly this combination to find every
  // opted-in user before joining against UserXp.
  @@index([consentType, granted])
  @@map("consents")
}

// ---------------------------------------------------------------------------
// 4.2 Sector catalog (schema-driven)
// ---------------------------------------------------------------------------

enum SectorStatus {
  live
  coming_soon
}

model SectorConfig {
  id     String       @id @default(uuid())
  name   String
  slug   String       @unique
  status SectorStatus @default(live)

  categories Category[]

  @@map("sectors")
}

model Category {
  id       String       @id @default(uuid())
  sectorId String       @map("sector_id")
  sector   SectorConfig @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  name     String
  slug     String

  attributeSchema   AttributeSchemaField[]
  listings          Listing[]
  comparisons       Comparison[]
  scrapeSources     ScrapeSource[]
  scrapedItems      ScrapedItem[]
  corporateRequests CorporateRequest[]
  discountRules     DiscountRule[]
  priceCapRules     PriceCapRule[]

  @@unique([sectorId, slug])
  @@map("categories")
}

enum AttributeDataType {
  number
  string
  enum
  boolean
}

model AttributeSchemaField {
  id           String            @id @default(uuid())
  categoryId   String            @map("category_id")
  category     Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  key          String
  label        String
  dataType     AttributeDataType @map("data_type")
  unit         String?
  isComparable Boolean           @default(true) @map("is_comparable")
  sortOrder    Int               @default(0) @map("sort_order")

  @@unique([categoryId, key])
  @@map("attribute_schema")
}

model Provider {
  id              String  @id @default(uuid())
  name            String
  logoUrl         String? @map("logo_url")
  verified        Boolean @default(true)
  // Nullable: the ~15 seeded reference providers (CBZ, Econet, etc.) have no
  // login of their own — this is only set when a "provider" role account is
  // admin-linked to self-manage this provider's listings (see /provider,
  // /admin/users). SetNull rather than Cascade: deleting the linked user
  // account shouldn't delete the provider or its listings.
  ownerUserId     String? @unique @map("owner_user_id")
  owner           User?   @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  // Set by an admin to link every "corporate" role user whose email matches
  // this domain (e.g. "cbz.co.zw") to this Provider — many logins to one
  // company, unlike ownerUserId above which is strictly one-to-one for the
  // informal "provider" role. Resolved at request time in corporateAuth.ts,
  // the same domain-match pattern orgVerification.ts already uses for
  // REGULATORS, rather than a separate per-user join table.
  corporateDomain String? @unique @map("corporate_domain")
  // Company-profile field for the corporate portal ("even profile should be
  // for the company, not a person") — /corporate/profile edits this directly.
  description     String?

  listings          Listing[]
  scrapedItems      ScrapedItem[]
  corporateRequests CorporateRequest[]
  discountRules     DiscountRule[]
  alertRules        AlertRule[]
  apiKeys           ApiKey[]
  investigations    ListingInvestigation[]

  @@map("providers")
}

enum FreshnessStatus {
  fresh
  stale
  unverified
}

enum ListingStatus {
  draft
  pending_review
  published
  rejected
}

// Who/what most recently wrote this listing's data — surfaced publicly on
// /listing/[id] ("Last updated by ...") so a shopper can tell a scraper's
// guess apart from the business's own confirmation. `seed` is the default so
// every pre-existing/admin-seeded row has a defined value without a backfill.
enum ListingUpdateSource {
  admin
  scraper
  corporate
  seed
}

model Listing {
  id               String              @id @default(uuid())
  categoryId       String              @map("category_id")
  category         Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  providerId       String              @map("provider_id")
  provider         Provider            @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  attributes       Json
  price            Decimal             @db.Decimal(12, 2)
  currency         String              @default("USD")
  sourceUrl        String?             @map("source_url")
  images           String[]            @default([]) @map("images")
  // Real user reviews aren't collected anywhere in the app yet — these stay
  // null until that exists. Never backfill/estimate a value here; the UI
  // must render "No reviews yet" rather than invent a number.
  rating           Decimal?            @db.Decimal(2, 1)
  reviewCount      Int                 @default(0) @map("review_count")
  lastVerifiedAt   DateTime            @default(now()) @map("last_verified_at")
  freshnessStatus  FreshnessStatus     @default(fresh) @map("freshness_status")
  // Provider self-submission workflow (build plan 15.2): draft -> pending_review
  // -> published/rejected. Defaults to "published" so every existing/admin-created
  // listing keeps behaving exactly as before — this workflow only applies to
  // listings a provider submits through /provider.
  status           ListingStatus       @default(published)
  rejectionReason  String?             @map("rejection_reason")
  lastUpdateSource ListingUpdateSource @default(seed) @map("last_update_source")

  priceHistory      ListingPriceHistory[]
  savedBy           SavedListing[]
  pinnedBy          PinnedListing[]
  recommendations   Recommendation[]
  notifications     Notification[]
  scrapedItems      ScrapedItem[]
  corporateRequests CorporateRequest[]
  updateLogs        ListingUpdateLog[]
  discountRules     DiscountRule[]
  investigations    ListingInvestigation[]
  marketBasketItems MarketBasketItem[]
  complaints        ConsumerComplaint[]

  // (categoryId, status, price): the consumer-facing hot path — every
  // catalog read filters this combination then orders by price
  // (getCategoryWithListings et al.). status alone: the admin review queue
  // filters by status with no categoryId, which can't use the composite
  // index's later columns without its first. providerId: the provider
  // portal's "my listings" query.
  @@index([categoryId, status, price])
  @@index([status])
  @@index([providerId])
  @@map("listings")
}

model ListingPriceHistory {
  id         String   @id @default(uuid())
  listingId  String   @map("listing_id")
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  price      Decimal  @db.Decimal(12, 2)
  recordedAt DateTime @default(now()) @map("recorded_at")

  // computePriceTrend/computePriceForecast read a listing's full history
  // ordered by time — this is the exact access pattern.
  @@index([listingId, recordedAt])
  @@map("listing_price_history")
}

/// Append-only "what changed and by whom" trail for a listing — mirrors
/// ListingPriceHistory's shape but for the full edit (name/description/
/// attributes/etc, not just price), written by every write path that sets
/// Listing.lastUpdateSource (admin edit, scraper approval, corporate direct
/// edit). Shown in the corporate portal's product list and (source only,
/// never actorLabel for admin) on the public listing page.
model ListingUpdateLog {
  id            String              @id @default(uuid())
  listingId     String              @map("listing_id")
  listing       Listing             @relation(fields: [listingId], references: [id], onDelete: Cascade)
  source        ListingUpdateSource
  // Admin email / "Web scraper" / the provider's name — internal record only,
  // never rendered on the public listing page for source: admin (see
  // PROVENANCE_LABEL in listingDisplay.ts).
  actorLabel    String              @map("actor_label")
  changeSummary String              @map("change_summary")
  createdAt     DateTime            @default(now()) @map("created_at")

  @@index([listingId, createdAt(sort: Desc)])
  @@map("listing_update_logs")
}

enum CorporateRequestType {
  edit
  new_listing
}

enum CorporateRequestStatus {
  pending
  approved
  rejected
}

/// A "corporate" role account's proposed price/product change, awaiting
/// admin review — never written to Listing directly (mirrors ScrapedItem's
/// pending/approved/rejected shape above, but submitted by the business
/// itself rather than extracted from a scraped page). See
/// /corporate/products and /admin/corporate-requests.
model CorporateRequest {
  id                String                 @id @default(uuid())
  providerId        String                 @map("provider_id")
  provider          Provider               @relation(fields: [providerId], references: [id], onDelete: Cascade)
  submittedByUserId String                 @map("submitted_by_user_id")
  submittedBy       User                   @relation(fields: [submittedByUserId], references: [id], onDelete: Cascade)
  type              CorporateRequestType
  // Set for `edit` — the listing this request proposes to change.
  listingId         String?                @map("listing_id")
  listing           Listing?               @relation(fields: [listingId], references: [id], onDelete: Cascade)
  // Set for `new_listing` — needed to know the attribute schema when
  // creating the Listing on approval, since there's no existing row yet.
  categoryId        String?                @map("category_id")
  category          Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // {name, description, price, currency, attributes, images}
  proposedData      Json                   @map("proposed_data")
  // The business's justification for the change — expected here (formal,
  // audited accounts) even though the informal provider self-edit flow has
  // no equivalent field.
  reason            String
  status            CorporateRequestStatus @default(pending)
  reviewedByEmail   String?                @map("reviewed_by_email")
  reviewedAt        DateTime?              @map("reviewed_at")
  // Admin's confirmation note on approval — a lightweight "digital sign-off"
  // (this app has no e-signature capture anywhere), distinct from
  // rejectionReason which is shown back to the business, not internal.
  reviewNote        String?                @map("review_note")
  rejectionReason   String?                @map("rejection_reason")
  // Set on creation (see corporateRequestSla.ts) so the review queue can
  // surface how close a request is to breaching its review window.
  dueAt             DateTime?              @map("due_at")
  createdAt         DateTime               @default(now()) @map("created_at")

  @@index([providerId])
  @@index([status, createdAt(sort: Desc)])
  @@map("corporate_requests")
}

// ---------------------------------------------------------------------------
// 4.3 User comparison activity
// ---------------------------------------------------------------------------

model Comparison {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  listingIds String[] @map("listing_ids")
  createdAt  DateTime @default(now()) @map("created_at")

  // Every quest-progress check (category_count/comparison_count/
  // sector_diversity criteria) queries exactly userId + a createdAt range,
  // on every comparison_completed event.
  @@index([userId, createdAt(sort: Desc)])
  // getAlsoCompared's `listingIds: { has: listingId }` is an array-
  // containment query — a GIN index is the correct index type for that,
  // not a btree.
  @@index([listingIds], type: Gin)
  @@map("comparisons")
}

model SavedListing {
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String   @map("listing_id")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  savedAt   DateTime @default(now()) @map("saved_at")

  @@id([userId, listingId])
  // The PK above already covers a plain userId filter (leftmost prefix),
  // but the saved-listings page also orders by savedAt (most recent
  // first) — a separate index matching that exact order avoids an
  // in-memory sort.
  @@index([userId, savedAt(sort: Desc)])
  @@map("saved_listings")
}

model PinnedListing {
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String   @map("listing_id")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  pinnedAt  DateTime @default(now()) @map("pinned_at")

  @@id([userId, listingId])
  // Mirrors saved_listings: the PK covers a plain userId filter, and a
  // (userId, pinnedAt) index keeps the "pins first" recents ordering an
  // index scan instead of an in-memory sort.
  @@index([userId, pinnedAt(sort: Desc)])
  @@map("pinned_listings")
}

model Recommendation {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId    String   @map("listing_id")
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  explanation  String
  confidence   Decimal  @db.Decimal(4, 3)
  scoreVersion String   @default("v1") @map("score_version")
  generatedAt  DateTime @default(now()) @map("generated_at")

  @@index([listingId])
  @@index([userId, generatedAt(sort: Desc)])
  @@map("recommendations")
}

enum NotificationType {
  price_drop
  listing_approved
  listing_rejected
  // Corporate: an AlertRule's provider-scoped metric crossed its threshold.
  // Not tied to one listing, so this is the first type without a listingId.
  alert_threshold_crossed
  // Admin: a BusinessCondition assigned to this admin is past its review cycle.
  business_condition_review_due
  // Regulator: a PriceCapRule's gazetted ceiling is breached by at least one
  // published listing in its category — one summary notification per rule,
  // same "compute + upsert on read" shape as alert_threshold_crossed.
  price_cap_breached
}

model Notification {
  id                  String             @id @default(uuid())
  userId              String             @map("user_id")
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Nullable: alert_threshold_crossed, business_condition_review_due, and
  // price_cap_breached notifications reference an AlertRule/
  // BusinessCondition/PriceCapRule instead (below), not a single listing.
  listingId           String?            @map("listing_id")
  listing             Listing?           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  alertRuleId         String?            @map("alert_rule_id")
  alertRule           AlertRule?         @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)
  businessConditionId String?            @map("business_condition_id")
  businessCondition   BusinessCondition? @relation(fields: [businessConditionId], references: [id], onDelete: Cascade)
  priceCapRuleId      String?            @map("price_cap_rule_id")
  priceCapRule        PriceCapRule?      @relation(fields: [priceCapRuleId], references: [id], onDelete: Cascade)
  type                NotificationType   @default(price_drop)
  message             String
  // Only meaningful for price_drop; null for every other type.
  changePercent       Float?             @map("change_percent")
  read                Boolean            @default(false)
  createdAt           DateTime           @default(now()) @map("created_at")

  // Each unique constraint dedupes one type's re-sync (upsert) against its
  // own scoping column; the other scoping columns are null on that row, and
  // Postgres treats NULL as distinct in a unique index, so these four
  // constraints never conflict with each other.
  @@unique([userId, listingId, type])
  @@unique([userId, alertRuleId, type])
  @@unique([userId, businessConditionId, type])
  @@unique([userId, priceCapRuleId, type])
  @@index([listingId])
  @@index([userId, read, createdAt(sort: Desc)])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// 4.4 AI chat assistant
// ---------------------------------------------------------------------------

enum ChatRole {
  user
  assistant
}

model Conversation {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now()) @map("created_at")
  lastMessageAt DateTime @default(now()) @map("last_message_at")

  messages Message[]

  @@index([userId, createdAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ChatRole
  content        String
  listingIds     String[]     @default([]) @map("listing_ids")
  createdAt      DateTime     @default(now()) @map("created_at")

  feedback ChatFeedback[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// 6. Gamification
// ---------------------------------------------------------------------------

enum EventType {
  profile_completed
  comparison_viewed
  comparison_completed
  recommendation_viewed
  item_saved
  action_taken
  daily_visit
  chat_started
  advert_opened
}

model UserEvent {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector    Sector?
  eventType EventType @map("event_type")
  metadata  Json?
  createdAt DateTime  @default(now()) @map("created_at")

  // Every badge-trigger check (event_count_in_sector/distinct_sector_count)
  // queries exactly this combination, on every qualifying event.
  @@index([userId, eventType, createdAt(sort: Desc)])
  @@map("user_events")
}

model GamificationRule {
  eventType    EventType @id @map("event_type")
  xpValue      Int       @map("xp_value")
  badgeTrigger Json?     @map("badge_trigger")
  questTrigger Json?     @map("quest_trigger")

  @@map("gamification_rules")
}

model UserXp {
  userId  String @id @map("user_id")
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalXp Int    @default(0) @map("total_xp")
  level   Int    @default(1)

  // The leaderboard's ORDER BY totalXp DESC.
  @@index([totalXp(sort: Desc)])
  @@map("user_xp")
}

model Badge {
  id          String @id @default(uuid())
  name        String @unique
  description String
  criteria    Json

  users UserBadge[]

  @@map("badges")
}

model UserBadge {
  userId   String   @map("user_id")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId  String   @map("badge_id")
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt DateTime @default(now()) @map("earned_at")

  @@id([userId, badgeId])
  @@map("user_badges")
}

model Quest {
  id          String   @id @default(uuid())
  name        String
  description String
  criteria    Json
  activeFrom  DateTime @map("active_from")
  activeTo    DateTime @map("active_to")

  progress UserQuestProgress[]

  // quest-rotation checks "is anything active right now" via activeTo.
  @@index([activeTo])
  @@map("quests")
}

model UserQuestProgress {
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId     String    @map("quest_id")
  quest       Quest     @relation(fields: [questId], references: [id], onDelete: Cascade)
  progress    Int       @default(0)
  completedAt DateTime? @map("completed_at")

  @@id([userId, questId])
  @@map("user_quest_progress")
}

model UserStreak {
  userId         String    @id @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak  Int       @default(0) @map("current_streak")
  longestStreak  Int       @default(0) @map("longest_streak")
  lastActiveDate DateTime? @map("last_active_date") @db.Date

  @@map("user_streaks")
}

enum SocialPlatform {
  telegram
  reddit
}

enum SentimentLabel {
  positive
  negative
  neutral
}

/// A public social post mentioning a price, found by the free social-media
/// price scanner (see scripts/social-scan). Read-only intelligence feed —
/// never shown to end users directly, reviewed by an admin before any
/// listing/price data is acted on.
model SocialPriceMention {
  id              String          @id @default(uuid())
  platform        SocialPlatform
  channel         String // Telegram channel username, or subreddit name
  sourceUrl       String          @map("source_url")
  postedAt        DateTime?       @map("posted_at")
  discoveredAt    DateTime        @default(now()) @map("discovered_at")
  text            String
  matchedProvider String?         @map("matched_provider")
  extractedPrices Json            @map("extracted_prices") // ExtractedPrice[]
  reviewed        Boolean         @default(false)
  // Null = not yet classified. Computed lazily (see lib/sentiment.ts) rather
  // than at scan time, so the scanner script stays free of an AI-provider
  // dependency — the same "compute on read, persist" shape as
  // syncPriceDropNotifications and friends.
  sentiment       SentimentLabel? @map("sentiment")

  @@unique([platform, sourceUrl])
  @@index([matchedProvider])
  // The admin review queue's reviewed/unreviewed toggle, newest first.
  @@index([reviewed, discoveredAt(sort: Desc)])
  @@map("social_price_mentions")
}

enum ScrapeTrigger {
  cron
  admin_manual
}

/// A provider page an admin wants crawled periodically for pricing (see
/// scripts/scrape, /admin/scraper). Distinct from SocialPriceMention's free
/// social scan — this targets known provider/regulator URLs on a schedule.
model ScrapeSource {
  id         String    @id @default(uuid())
  name       String
  url        String
  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  enabled    Boolean   @default(true)
  lastRunAt  DateTime? @map("last_run_at")
  lastError  String?   @map("last_error")
  createdAt  DateTime  @default(now()) @map("created_at")

  items ScrapedItem[]

  @@index([enabled])
  @@map("scrape_sources")
}

enum ScrapeItemStatus {
  pending
  approved
  rejected
}

/// A candidate listing extracted from a scraped/searched page, awaiting
/// admin review — never written to Listing directly. See
/// /admin/scraper and src/app/api/admin/scraped-items.
model ScrapedItem {
  id                  String           @id @default(uuid())
  sourceId            String?          @map("source_id")
  source              ScrapeSource?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  // Carried alongside sourceId (from ScrapeSource.categoryId) or set directly
  // on an admin-search hit — the only categorization ScrapedItem has, needed
  // to create a Listing on approval when there's no suggestedListingId.
  categoryId          String?          @map("category_id")
  category            Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sourceUrl           String           @map("source_url")
  triggeredBy         ScrapeTrigger    @map("triggered_by")
  // Firecrawl markdown snapshot of the page at fetch time — kept so an admin
  // can see exactly what the extraction was based on, not just its output.
  rawContent          String           @map("raw_content")
  // Candidate listing fields: {name, price, currency, description, attributes, providerNameGuess, categorySlug}
  extractedData       Json             @map("extracted_data")
  confidence          Float
  suggestedProviderId String?          @map("suggested_provider_id")
  suggestedProvider   Provider?        @relation(fields: [suggestedProviderId], references: [id], onDelete: SetNull)
  suggestedListingId  String?          @map("suggested_listing_id")
  suggestedListing    Listing?         @relation(fields: [suggestedListingId], references: [id], onDelete: SetNull)
  status              ScrapeItemStatus @default(pending)
  reviewedByEmail     String?          @map("reviewed_by_email")
  reviewedAt          DateTime?        @map("reviewed_at")
  rejectionReason     String?          @map("rejection_reason")
  discoveredAt        DateTime         @default(now()) @map("discovered_at")

  // The admin review queue's status filter, newest first.
  @@index([status, discoveredAt(sort: Desc)])
  @@index([sourceId])
  @@map("scraped_items")
}

/// Live FX reference rates (units per 1 USD), refreshed by
/// scripts/fx-refresh — overrides the static, hand-maintained defaults in
/// lib/currency.ts wherever a live rate exists. `code` matches
/// CurrencyCode ("ZiG"/"ZAR"/"GBP") even though the upstream source uses
/// ISO codes (ZWG for ZiG) — the refresh script maps between them.
model FxRate {
  code      String   @id
  perUsd    Float    @map("per_usd")
  source    String
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@map("fx_rates")
}

enum AdminAuditAction {
  listing_approved
  listing_rejected
  listing_deleted
  provider_linked
  provider_unlinked
  user_role_changed
  llm_model_changed
  scrape_item_approved
  scrape_item_rejected
  scrape_source_created
  advert_created
  advert_updated
  advert_deleted
  corporate_request_approved
  corporate_request_rejected
  corporate_domain_linked
  discount_rule_created
  discount_rule_deleted
  economic_driver_upserted
  economic_driver_deleted
  business_condition_created
  business_condition_updated
  business_condition_deleted
  api_key_created
  api_key_revoked
  listing_created
  provider_created
  scrape_source_updated
  scrape_source_deleted
  social_mention_reviewed
  market_basket_item_created
  market_basket_item_deleted
  investigation_flagged
  investigation_updated
  price_cap_rule_created
  price_cap_rule_updated
  price_cap_rule_deleted
  complaint_promoted
  user_suspended
  user_reactivated
}

// No FK relations to the acted-on row — an audit log needs to survive the
// row it's about being deleted (e.g. listing_deleted), which a Cascade
// would defeat and a SetNull would silently blank out.
model AdminAuditLog {
  id         String           @id @default(uuid())
  adminEmail String           @map("admin_email")
  action     AdminAuditAction
  targetType String           @map("target_type") // "listing" | "provider" | "user"
  targetId   String           @map("target_id")
  detail     String
  createdAt  DateTime         @default(now()) @map("created_at")

  // The admin audit page reads newest-first with no other filter.
  @@index([createdAt(sort: Desc)])
  @@map("admin_audit_log")
}

// Backs rate limiting on public unauthenticated endpoints (/api/waitlist,
// /api/need-intake) without needing new infra (Redis/Upstash) — this app
// deploys to Vercel (see vercel.json), where an in-memory counter wouldn't
// reliably survive across serverless invocations, but Postgres already does.
// Self-cleaning: checkRateLimit deletes a key's own expired hits on every
// call, so this never needs a separate cron sweep.
model RateLimitHit {
  id        String   @id @default(uuid())
  key       String // e.g. "need-intake:203.0.113.5"
  createdAt DateTime @default(now()) @map("created_at")

  @@index([key, createdAt])
  @@map("rate_limit_hits")
}

// Caches /api/recommendations' Claude output per distinct listing-set (not
// per-user — the recommendation is a pure function of the listing set, the
// route doesn't factor in the caller's footprint). Comparing the same 2-3
// listings repeatedly is common while a user is deciding; this skips the
// re-bill on a cache hit. Deliberately separate from the Recommendation
// table, which stays the audit-grade "this user got this recommendation at
// this time" record and is still written on every request, cache hit or not.
model RecommendationCache {
  cacheKey  String   @id @map("cache_key")
  payload   Json
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("recommendation_cache")
}

// ---------------------------------------------------------------------------
// LLM routing & cost tracking
// ---------------------------------------------------------------------------

// One row per model call, written by lib/ai/provider.ts on both success and
// failure. Failures are recorded too: a route that starts erroring is the
// thing an admin most needs to see on the cost page, and a table that only
// holds successes makes an outage look like a traffic drop.
//
// Cost is stored per row rather than derived at read time from a price table
// — prices change, and a historical row must keep the cost it was actually
// billed at. Decimal, not Float: at $0.00000008/token a float's rounding
// error is a meaningful share of the value.
model LlmUsage {
  id           String  @id @default(uuid())
  provider     String // "anthropic" | "openrouter"
  model        String
  feature      String // "chat" | "recommendations" | "intake"
  userId       String? @map("user_id")
  inputTokens  Int     @default(0) @map("input_tokens")
  outputTokens Int     @default(0) @map("output_tokens")
  costUsd      Decimal @default(0) @map("cost_usd") @db.Decimal(14, 10)
  latencyMs    Int     @map("latency_ms")
  ok           Boolean @default(true)
  errorMessage String? @map("error_message")

  // Tier routing. `attempt` is 1 for the rung the complexity heuristic chose
  // and increments each time a failure pushed the call further up the ladder,
  // so "escalation rate" is just the share of rows with attempt > 1.
  // `complexity` is stored so the heuristics in lib/ai/tiers.ts can be re-tuned
  // later against what actually happened rather than from intuition.
  attempt       Int     @default(1)
  escalatedFrom String? @map("escalated_from")
  complexity    Float?

  createdAt DateTime @default(now()) @map("created_at")

  // No FK to User: usage is an operational record that must outlive the
  // account that generated it, the same reasoning as admin_audit_log.
  @@index([createdAt(sort: Desc)])
  @@index([feature, createdAt])
  @@index([model, createdAt])
  @@map("llm_usage")
}

// Small key/value store for operator-tunable runtime settings. Currently only
// the per-feature model selection (`llm.model.<feature>`), which admins change
// from /admin/llm without a redeploy.
model AppSetting {
  key       String   @id
  value     String
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// Admin-managed promo slots rotated through the explore page's ad card.
model Advert {
  id          String   @id @default(uuid())
  sponsorName String   @map("sponsor_name")
  tagline     String
  imageUrl    String   @map("image_url")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([active])
  @@map("adverts")
}

// ---------------------------------------------------------------------------
// Corporate pricing intelligence, governance & sentiment (Kuwana for
// Business feature expansion — see wobbly-prancing-sky.md plan)
// ---------------------------------------------------------------------------

enum DiscountScope {
  category
  listing
}

// A corporate-configured percentage markdown, applied at category or
// single-listing granularity. Applying a rule writes a normal
// ListingPriceHistory row (see lib/discounts.ts), so an active discount
// surfaces through the existing price-drop notification path for free —
// this table is the rule + its own history (query by providerId, newest
// first), not a separate "discount history" model.
model DiscountRule {
  id              String        @id @default(uuid())
  providerId      String        @map("provider_id")
  provider        Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  scope           DiscountScope
  categoryId      String?       @map("category_id")
  category        Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  listingId       String?       @map("listing_id")
  listing         Listing?      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  percentOff      Decimal       @map("percent_off") @db.Decimal(5, 2)
  startsAt        DateTime      @map("starts_at")
  endsAt          DateTime      @map("ends_at")
  createdByUserId String        @map("created_by_user_id")
  createdBy       User          @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([providerId, createdAt(sort: Desc)])
  @@index([listingId])
  @@map("discount_rules")
}

// Global macro indicator values (inflation, FX, interest rates), admin
// managed at /admin/economic-drivers — not per-corporate, every account
// reads the same rows. `period` is the month a value applies to.
model EconomicDriver {
  id             String   @id @default(uuid())
  name           String
  region         String   @default("ZW")
  value          Decimal  @db.Decimal(10, 4)
  previousValue  Decimal? @map("previous_value") @db.Decimal(10, 4)
  period         DateTime @db.Date
  currencyCode   String?  @map("currency_code")
  updatedByEmail String?  @map("updated_by_email")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([name, region, period])
  @@index([period(sort: Desc)])
  @@map("economic_drivers")
}

/// One representative good/service tracked as part of a named cost-of-living
/// basket (e.g. "Consumer Price Basket" -> 10kg mealie-meal, diesel, data
/// bundle...) — admin-curated, same "reference data an admin maintains"
/// pattern as EconomicDriver/BusinessCondition. The basket's index value
/// itself stays computed-on-read from each component's ListingPriceHistory
/// (see getBasketIndexTrend in lib/marketBasket.ts) rather than a separate
/// stored index table, matching how every other trend in this app works.
model MarketBasketItem {
  id         String   @id @default(uuid())
  basketName String   @map("basket_name")
  label      String
  listingId  String   @map("listing_id")
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  weight     Decimal  @default(1) @db.Decimal(6, 3)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([basketName, listingId])
  @@index([basketName])
  @@map("market_basket_items")
}

enum BusinessConditionCategory {
  regulatory
  competitor
  macro
}

enum RiskLevel {
  low
  medium
  high
}

// A tracked regulatory change, competitor move, or macro trigger that could
// affect pricing — managed by admin/regulator at /admin/business-conditions,
// surfaced read-only on /regulator and /corporate. documentUrls is a plain
// URL list rather than a separate documents table/model: no file-upload
// infra exists anywhere in this app yet, so this starts URL-only.
model BusinessCondition {
  id               String                    @id @default(uuid())
  title            String
  category         BusinessConditionCategory
  riskLevel        RiskLevel                 @default(medium) @map("risk_level")
  reviewCycleDays  Int?                      @map("review_cycle_days")
  notes            String?
  documentUrls     String[]                  @default([]) @map("document_urls")
  sectorSlug       String?                   @map("sector_slug")
  assignedToUserId String?                   @map("assigned_to_user_id")
  assignedTo       User?                     @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  notifications    Notification[]

  @@index([category])
  @@index([riskLevel])
  @@map("business_conditions")
}

enum AlertMetric {
  avg_price
  listing_count
  trending_down
  trending_up
  unverified_count
}

enum AlertDirection {
  above
  below
}

// A corporate-configured threshold that, when crossed, writes a Notification
// (extends NotificationType rather than a parallel delivery system — see
// lib/alerts.ts). One row per metric/threshold, evaluated on read (no cron
// yet — matches how syncPriceDropNotifications() runs on page load today).
model AlertRule {
  id              String         @id @default(uuid())
  providerId      String         @map("provider_id")
  provider        Provider       @relation(fields: [providerId], references: [id], onDelete: Cascade)
  metric          AlertMetric
  threshold       Decimal        @db.Decimal(12, 2)
  direction       AlertDirection
  enabled         Boolean        @default(true)
  createdByUserId String         @map("created_by_user_id")
  createdBy       User           @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now()) @map("created_at")
  notifications   Notification[]

  @@index([providerId])
  @@map("alert_rules")
}

/// A gazetted price ceiling for a category — sector/category-wide, unlike
/// AlertRule (which is always scoped to one provider's own metrics). A
/// regulator sets this once per category; getPriceCapBreaches() flags every
/// currently-published listing in that category priced above it, in the
/// rule's own currency (no FX conversion — a cap only ever compares like for
/// like).
model PriceCapRule {
  id              String         @id @default(uuid())
  categoryId      String         @map("category_id")
  category        Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  capValue        Decimal        @map("cap_value") @db.Decimal(12, 2)
  currency        String         @default("USD")
  enabled         Boolean        @default(true)
  createdByUserId String         @map("created_by_user_id")
  createdBy       User           @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now()) @map("created_at")
  notifications   Notification[]

  @@index([categoryId])
  @@map("price_cap_rules")
}

// Per-user, per-notification-type delivery preference. `channel` is always
// "inapp" for now — email/SMS have no delivery infra anywhere in this app,
// so the column exists for forward compatibility rather than active use.
model NotificationPreference {
  userId  String           @map("user_id")
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    NotificationType
  channel String           @default("inapp")
  enabled Boolean          @default(true)

  @@id([userId, type, channel])
  @@map("notification_preferences")
}

// API-key-secured access for external BI tools (see /api/bi/*). No FK-joined
// "usage log" table — lastUsedAt is enough for this app's scale, matching
// how RateLimitHit above keeps things minimal.
model ApiKey {
  id         String    @id @default(uuid())
  providerId String?   @map("provider_id")
  provider   Provider? @relation(fields: [providerId], references: [id], onDelete: Cascade)
  label      String
  hashedKey  String    @unique @map("hashed_key")
  scopes     String[]  @default([])
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  @@index([providerId])
  @@map("api_keys")
}

enum ChatFeedbackRating {
  up
  down
}

model ChatFeedback {
  id        String             @id @default(uuid())
  messageId String             @map("message_id")
  message   Message            @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String             @map("user_id")
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    ChatFeedbackRating
  comment   String?
  createdAt DateTime           @default(now()) @map("created_at")

  @@unique([messageId, userId])
  @@map("chat_feedback")
}

// ---------------------------------------------------------------------------
// Wallet top-up (Paynow, Zimbabwe payment gateway — web redirect flow)
// ---------------------------------------------------------------------------

enum TopUpStatus {
  initiated
  pending
  paid
  cancelled
  failed
  refunded
}

enum TopUpCurrency {
  USD
  ZiG
}

/// One row per wallet top-up attempt via Paynow's WEB REDIRECT flow. Single
/// mutable row updated in place as status progresses (initiated -> pending ->
/// paid/cancelled/failed) — this *is* the primary entity, so unlike
/// AdminAuditLog/ListingUpdateLog there's no separate "current state lives
/// elsewhere" row for an append-only log to supplement. paynowStatus keeps
/// Paynow's raw response string verbatim so a value our TopUpStatus enum
/// doesn't yet model is never silently dropped. See src/lib/paynow.ts and
/// src/app/api/wallet/*.
model WalletTransaction {
  id              String        @id @default(uuid())
  userId          String        @map("user_id")
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Sent to Paynow as `reference` — must be unique per attempt, since Paynow
  // requires a fresh reference per initiate call (reusing one produces
  // ambiguous poll/webhook matching).
  reference       String        @unique
  amount          Decimal       @db.Decimal(12, 2)
  currency        TopUpCurrency @default(USD)
  status          TopUpStatus   @default(initiated)
  // Paynow's own reference, only known after a successful initiate call.
  paynowReference String?       @map("paynow_reference")
  // Paynow's poll URL — used by the return-page poll fallback if the webhook
  // hasn't landed yet.
  pollUrl         String?       @map("poll_url")
  paynowStatus    String?       @map("paynow_status")
  failureReason   String?       @map("failure_reason")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // The user-facing top-up history read.
  @@index([userId, createdAt(sort: Desc)])
  // The admin transactions view's status filter, newest first.
  @@index([status, createdAt(sort: Desc)])
  @@map("wallet_transactions")
}

enum InvestigationStatus {
  open
  in_progress
  resolved
  dismissed
}

// The enforcement action a regulator recorded on closing a case — distinct
// from InvestigationStatus (which just tracks workflow state) because a
// corporate-initiated self-flag never has one; it stays "none" until a
// regulator account resolves it with a real action taken.
enum InvestigationOutcome {
  none
  warning
  fine
  suspension
}

/// Case-tracking for a flagged listing, opened either by a corporate account
/// self-flagging its own listing (self-service pricing-integrity workflow)
/// or by a regulator account investigating any provider (enforcement
/// workflow — see /regulator/investigations). Anomalies themselves stay
/// computed-on-read (getProviderFeeComparison / getSectorPricingSummary);
/// this is only the workflow state layered on top once someone decides a
/// flagged listing is worth tracking.
model ListingInvestigation {
  id               String               @id @default(uuid())
  listingId        String               @map("listing_id")
  listing          Listing              @relation(fields: [listingId], references: [id], onDelete: Cascade)
  providerId       String               @map("provider_id")
  provider         Provider             @relation(fields: [providerId], references: [id], onDelete: Cascade)
  // Snapshot of why this was flagged at creation time (e.g. "z-score 2.4,
  // 18% below category peer median") — kept even if the underlying price
  // changes later and the listing stops being an outlier.
  reason           String
  status           InvestigationStatus  @default(open)
  assignedToUserId String?              @map("assigned_to_user_id")
  assignedTo       User?                @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)
  notes            String?
  // Only ever set by a regulator closing a case with a real enforcement
  // action; stays "none" for corporate self-flagged investigations.
  outcome          InvestigationOutcome @default(none)
  // Supporting documents/screenshots a regulator attaches to a case — a
  // plain URL list rather than a separate documents table/model, matching
  // BusinessCondition.documentUrls (no file-upload infra exists yet).
  evidenceUrls     String[]             @default([]) @map("evidence_urls")
  createdAt        DateTime             @default(now()) @map("created_at")
  resolvedAt       DateTime?            @map("resolved_at")

  originatingComplaints ConsumerComplaint[]

  @@index([providerId, status])
  @@index([listingId])
  @@map("listing_investigations")
}

enum ComplaintStatus {
  open
  reviewing
  resolved
  dismissed
}

/// A consumer-reported price/service issue — the "report a price" hotline a
/// real price regulator relies on for most of its leads, distinct from
/// ListingInvestigation (which is a regulator/corporate-opened case, not a
/// public submission). Requires a logged-in consumer account: no anonymous
/// submission, so a complaint always ties back to a real user and gets
/// spam/abuse protection for free from the existing auth system rather than
/// needing its own (no CAPTCHA/rate-limit infra exists in this app yet).
model ConsumerComplaint {
  id                    String                @id @default(uuid())
  userId                String                @map("user_id")
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Nullable: a complaint can be general ("this shop is overcharging") rather
  // than tied to one specific listing.
  listingId             String?               @map("listing_id")
  listing               Listing?              @relation(fields: [listingId], references: [id], onDelete: SetNull)
  description           String
  status                ComplaintStatus       @default(open)
  // Set once a regulator promotes this complaint into a real case — SetNull
  // (not Cascade) so deleting the investigation doesn't also delete the
  // complaint that led to it.
  linkedInvestigationId String?               @map("linked_investigation_id")
  linkedInvestigation   ListingInvestigation? @relation(fields: [linkedInvestigationId], references: [id], onDelete: SetNull)
  createdAt             DateTime              @default(now()) @map("created_at")

  @@index([status, createdAt(sort: Desc)])
  @@index([listingId])
  @@map("consumer_complaints")
}

enum AdminAlertMetric {
  total_providers
  published_listings
  pending_review_listings
  open_investigations
  pending_corporate_requests
}

/// Admin's counterpart to AlertRule — same threshold-crossing shape (see
/// lib/alerts.ts) but every metric is a platform-wide count rather than one
/// provider's own listings, so it isn't scoped by providerId. Evaluated live
/// on read, same as AlertRule (no cron yet); kept as its own model instead of
/// making AlertRule.providerId nullable, since every other AlertRule query
/// in this codebase assumes a real provider.
model AdminAlertRule {
  id              String           @id @default(uuid())
  metric          AdminAlertMetric
  threshold       Decimal          @db.Decimal(12, 2)
  direction       AlertDirection
  enabled         Boolean          @default(true)
  createdByUserId String           @map("created_by_user_id")
  createdBy       User             @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now()) @map("created_at")

  @@map("admin_alert_rules")
}
