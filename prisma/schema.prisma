// Kuwana MVP — data model (see KUWANA_MVP_BUILD_PLAN.md Section 4 & 6)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model WaitlistSignup {
  id        String   @id @default(uuid())
  email     String
  sector    String // 'healthcare' for MVP; kept generic for future coming-soon sectors
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([email, sector])
  @@map("waitlist_signups")
}

// ---------------------------------------------------------------------------
// 4.1 Identity & onboarding
// ---------------------------------------------------------------------------

enum Role {
  consumer
  corporate
  regulator
  provider
  admin
}

enum AccountStatus {
  active
  suspended
}

// Corporate/Provider/Regulator self-service accounts get full access
// immediately (see /api/onboarding) — this is purely informational for a
// future admin review UI, never a gate (nothing reads it to block access
// yet). Consumer accounts never leave `not_applicable`.
enum ApplicationStatus {
  not_applicable
  pending
  approved
  rejected
}

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  // The user-facing unique handle captured at signup (replaces the old free-text
  // "full name" field) — doubles as a stable, human-picked identifier alongside `id`.
  username               String    @unique
  role                   Role      @default(consumer)
  createdAt              DateTime  @default(now()) @map("created_at")
  // bcrypt hash (cost 12), set at registration by api/auth/register and compared
  // in nextAuth.ts's authorize(). Nullable: rows predating the Auth.js migration
  // have no extractable hash (Supabase owned auth.users before this), and any
  // future passwordless identity would legitimately have none either. A null
  // here means "cannot sign in with a password" — authorize() treats it that way.
  passwordHash           String?   @map("password_hash")
  // Set once /api/onboarding completes successfully. Null between
  // /api/auth/register creating the row and onboarding finishing — filters out
  // abandoned signups from admin/leaderboard views without a separate table.
  onboardingCompletedAt  DateTime? @map("onboarding_completed_at")
  // Admin-only kill switch (see requireUser() in lib/auth.ts, the single
  // choke point almost every page/route calls through) — a suspended
  // account is blocked everywhere immediately, not just re-gated at login.
  accountStatus          AccountStatus @default(active) @map("account_status")
  suspendedAt            DateTime? @map("suspended_at")
  suspendedReason        String?   @map("suspended_reason")
  // Grants access to specific gated sub-features regardless of role (e.g.
  // corporate feature keys) — empty means "full access for this role", the
  // same fallback semantics as coarse role checks everywhere else in this
  // file. Feature keys are plain strings defined where they're checked, not
  // as an enum, so a new gated feature never needs a migration.
  allowedFeatures        String[]  @default([]) @map("allowed_features")
  // Spendable wallet balances, credited by a webhook when a WalletTransaction
  // flips to paid (see WalletTransaction below) — one field per supported
  // top-up currency rather than a generic multi-currency Wallet model, since
  // Paynow only ever settles in USD or ZiG for this integration.
  walletBalanceUsd       Decimal   @default(0) @map("wallet_balance_usd") @db.Decimal(12, 2)
  walletBalanceZig       Decimal   @default(0) @map("wallet_balance_zig") @db.Decimal(12, 2)
  // Set at signup for corporate accounts — which industry they operate in, so
  // Market Intelligence/business conditions can default to their own market
  // instead of an unfiltered all-sectors view. Not meaningful for other roles.
  primarySector          Sector?   @map("primary_sector")
  // Cooldown gate for the price-drop notification sync (see
  // api/notifications/route.ts) — persisted rather than in-memory because
  // this app deploys on Vercel (see vercel.json), where a request can land
  // on any warm instance and an in-process Map isn't reliably shared.
  lastNotificationSyncAt DateTime? @map("last_notification_sync_at")
  // Set when the user entered the emailed one-time code (see
  // EmailVerificationCode and src/lib/email/verification.ts). Checked by
  // requireUser(), the same choke point that gates suspended accounts, so an
  // unverified account is blocked everywhere at once rather than at each
  // route. Nullable and backfilled to `created_at` for every row that existed
  // before this shipped — gating accounts retroactively would lock out the
  // entire user base for a control they were never offered.
  emailVerifiedAt        DateTime? @map("email_verified_at")
  // Stamped by /api/auth/register once the pre-signup consent gate (ToS +
  // Cyber and Data Protection Act [Chapter 12:07] disclosure) is passed —
  // register rejects the request outright if it isn't. Distinct from
  // Consent (below), which covers the optional research/leaderboard/health
  // opt-ins captured later in onboarding, not this mandatory gate.
  consentAcceptedAt      DateTime? @map("consent_accepted_at")
  // Set to `pending` by /api/onboarding for corporate/provider/regulator
  // signups only (stays not_applicable for consumers) — surfaced to a future
  // admin approve/reject UI. Deliberately not read anywhere as a gate today;
  // see notifyAdminNewApplication in src/lib/notifications.ts for the only
  // other thing that reacts to it.
  applicationStatus      ApplicationStatus @default(not_applicable) @map("application_status")
  // Business registration / ID documents uploaded on the "verification" step
  // of the corporate/provider/regulator signup wizard (see
  // /api/onboarding/verification-docs) — empty for consumers, who never see
  // that step. Deprecated in favor of verificationDocuments (below), which
  // carries a label per document; kept (rather than dropped) because this
  // column's own migration (20260819000000) is already committed at this
  // HEAD and there's no way from this environment to confirm whether it's
  // already deployed against a database holding real applicant rows — see
  // the new migration's comment for the full tradeoff. Nothing writes to
  // this column anymore.
  verificationDocumentUrls String[] @default([]) @map("verification_document_urls")
  // {label, url}[] — replaces verificationDocumentUrls above so each upload
  // slot on the "verification" step (e.g. corporate's "Certificate of
  // Incorporation" vs "Tax Clearance Certificate") keeps its own label
  // instead of an unlabeled flat list. Empty for consumers.
  verificationDocuments  Json      @default("[]") @map("verification_documents")
  // Tailored per-role object from the "applicationDetails" step
  // (registrationNumber/taxNumber/... for corporate, businessType/... for
  // provider, jurisdiction/... for regulator) — a Json blob rather than
  // dozens of mostly-null columns, since only a handful of fields are ever
  // relevant to any one role. See that step in src/app/signup/page.tsx and
  // the corporate/provider/regulator branches of /api/onboarding/route.ts
  // for the exact shape per role. Null for consumers.
  applicationDetails     Json?     @map("application_details")
  // Declarations captured on the "declarations" step — plain booleans (not
  // folded into applicationDetails) since a future admin review UI will want
  // to query/filter on these directly, the same reasoning applicationStatus
  // above already documents. authorizedToActDeclared is regulator-only
  // (replaces dataProtectionComplianceDeclared for that role, since a
  // regulator's declaration is about institutional authority, not data
  // handling); dataProtectionComplianceDeclared is corporate/provider-only.
  // Both default false and simply go unused for consumer/whichever role
  // doesn't ask for them, same pattern as primarySector above.
  accurateInfoDeclared     Boolean @default(false) @map("accurate_info_declared")
  dataProtectionComplianceDeclared Boolean @default(false) @map("data_protection_compliance_declared")
  authorizedToActDeclared  Boolean @default(false) @map("authorized_to_act_declared")
  // Captured on the same verification step — an applicant asking for a
  // bespoke dashboard/interface beyond the standard corporate/provider/
  // regulator portal. Informational only, same as applicationStatus.
  customInterfaceRequested Boolean  @default(false) @map("custom_interface_requested")
  customInterfaceNotes    String?  @map("custom_interface_notes")
  // Laid down for a future admin approve/reject UI — nothing reads these yet.
  reviewedByEmail        String?   @map("reviewed_by_email")
  reviewedAt             DateTime? @map("reviewed_at")

  profile                 UserProfile?
  footprints              SectorFootprint[]
  consents                Consent[]
  comparisons             Comparison[]
  savedListings           SavedListing[]
  pinnedListings          PinnedListing[]
  recommendations         Recommendation[]
  events                  UserEvent[]
  xp                      UserXp?
  badges                  UserBadge[]
  questProgress           UserQuestProgress[]
  streak                  UserStreak?
  subscription            Subscription?
  notifications           Notification[]
  // Opposite side of Notification.applicantUserId — admin notifications that
  // reference this user as the applicant, not the recipient (that's the
  // plain `notifications` relation above via Notification.userId).
  applicationNotifications Notification[] @relation("NotificationApplicant")
  conversations           Conversation[]
  ownedProvider           Provider?
  providerMembership      ProviderMember?
  corporateRequests       CorporateRequest[]
  discountRulesCreated    DiscountRule[]
  alertRulesCreated       AlertRule[]
  assignedConditions      BusinessCondition[]
  notificationPreferences NotificationPreference[]
  chatFeedback            ChatFeedback[]
  walletTransactions      WalletTransaction[]
  assignedInvestigations  ListingInvestigation[]
  priceCapRulesCreated    PriceCapRule[]
  complaints              ConsumerComplaint[]
  adminAlertRulesCreated  AdminAlertRule[]
  notes                   UserNote[]

  @@map("users")
}

/// One-time codes emailed at signup to prove the person controls the address
/// they registered (see src/lib/email/verification.ts).
///
/// `userId` is the Supabase auth uid and is deliberately NOT a foreign key to
/// `users`. The row it would point at does not exist yet: signup creates the
/// Supabase auth user first and this app's `User` row only when
/// /api/onboarding completes — which is precisely what verification gates. A
/// FK here would make the table unusable at the only moment it is needed.
///
/// The code itself is never stored. `codeHash` is an HMAC-SHA256 of the code
/// under a server-held key, so a database disclosure does not hand over
/// working codes: six digits is 10^6 possibilities, which an unkeyed hash
/// surrenders in under a second.
model EmailVerificationCode {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  // Bound into the row so a code minted for one address can never be redeemed
  // against another — a user who changes their email mid-flow must request a
  // new code rather than reuse the one already in their inbox.
  email     String
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  // Set the moment a code is accepted, which is what makes it single-use.
  // Kept (rather than deleting the row) because /api/onboarding reads it back
  // as the proof that this signup verified at all.
  consumedAt DateTime? @map("consumed_at")
  // Wrong guesses against THIS code. Bounded server-side so an attacker
  // cannot walk the 10^6 space of a live code; the rate limiter bounds how
  // fast they can ask for new ones.
  attempts  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")

  // Every read is "the newest code for this user", and the cron sweep deletes
  // by expiry.
  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("email_verification_codes")
}

model UserProfile {
  userId          String   @id @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ageRange        String?  @map("age_range")
  occupation      String?
  location        String?
  fullName        String?  @map("full_name")
  nickname        String?
  socialPlatforms String[] @default([]) @map("social_platforms")

  @@map("user_profiles")
}

enum Sector {
  telecom
  banking
  insurance
  education
  healthcare
  transport
  utilities
  pharmacy
  electronics
  fashion
  hotels
  retail
}

model SectorFootprint {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector Sector
  data   Json

  @@unique([userId, sector])
  @@map("sector_footprints")
}

// Free-text "memory" captured from a category-specific clarifying-question
// prompt (currently shown before an Insurance AI recommendation) — one row
// per (user, sector, category), overwritten on re-submit rather than kept as
// a log. Read back by the recommendations route to fold into the AI prompt
// context whenever a matching sector/category is requested, so it's reusable
// by any future sector's intake flow, not just Insurance's.
model UserNote {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector    Sector
  // Category slug (e.g. "medical-aid-plans"); "" means sector-general notes.
  // Kept a plain non-null string (rather than nullable) so the compound
  // unique constraint below works as a single upsert target without having
  // to special-case null in every read/write call site.
  category  String   @default("")
  content   Json
  source    String   @default("intake")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, sector, category])
  @@map("user_notes")
}

model Consent {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentType String   @map("consent_type") // 'research_use' | 'leaderboard_participation'
  granted     Boolean
  grantedAt   DateTime @default(now()) @map("granted_at")

  @@unique([userId, consentType])
  // The leaderboard query filters exactly this combination to find every
  // opted-in user before joining against UserXp.
  @@index([consentType, granted])
  @@map("consents")
}

// ---------------------------------------------------------------------------
// 4.2 Sector catalog (schema-driven)
// ---------------------------------------------------------------------------

enum SectorStatus {
  live
  coming_soon
}

model SectorConfig {
  id     String       @id @default(uuid())
  name   String
  slug   String       @unique
  status SectorStatus @default(live)

  categories Category[]

  @@map("sectors")
}

model Category {
  id       String       @id @default(uuid())
  sectorId String       @map("sector_id")
  sector   SectorConfig @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  name     String
  slug     String

  attributeSchema   AttributeSchemaField[]
  listings          Listing[]
  comparisons       Comparison[]
  scrapeSources     ScrapeSource[]
  scrapedItems      ScrapedItem[]
  corporateRequests CorporateRequest[]
  discountRules     DiscountRule[]
  priceCapRules     PriceCapRule[]

  @@unique([sectorId, slug])
  @@map("categories")
}

enum AttributeDataType {
  number
  string
  enum
  boolean
}

model AttributeSchemaField {
  id           String            @id @default(uuid())
  categoryId   String            @map("category_id")
  category     Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  key          String
  label        String
  dataType     AttributeDataType @map("data_type")
  unit         String?
  isComparable Boolean           @default(true) @map("is_comparable")
  sortOrder    Int               @default(0) @map("sort_order")

  @@unique([categoryId, key])
  @@map("attribute_schema")
}

model Provider {
  id              String  @id @default(uuid())
  name            String
  logoUrl         String? @map("logo_url")
  // The company's own homepage — the fallback "visit provider" link used
  // wherever a Listing has no more specific sourceUrl of its own.
  websiteUrl      String? @map("website_url")
  verified        Boolean @default(true)
  // Nullable: the ~15 seeded reference providers (CBZ, Econet, etc.) have no
  // login of their own — this is only set when a "provider" role account is
  // admin-linked to self-manage this provider's listings (see /provider,
  // /admin/users). SetNull rather than Cascade: deleting the linked user
  // account shouldn't delete the provider or its listings.
  ownerUserId     String? @unique @map("owner_user_id")
  owner           User?   @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  // Set by an admin to link every "corporate" role user whose email matches
  // this domain (e.g. "cbz.co.zw") to this Provider — many logins to one
  // company, unlike ownerUserId above which is strictly one-to-one for the
  // informal "provider" role. Resolved at request time in corporateAuth.ts,
  // the same domain-match pattern orgVerification.ts already uses for
  // REGULATORS, rather than a separate per-user join table.
  corporateDomain String? @unique @map("corporate_domain")
  // Company-profile field for the corporate portal ("even profile should be
  // for the company, not a person") — /corporate/profile edits this directly.
  description     String?

  listings          Listing[]
  scrapedItems      ScrapedItem[]
  corporateRequests CorporateRequest[]
  discountRules     DiscountRule[]
  alertRules        AlertRule[]
  apiKeys           ApiKey[]
  investigations    ListingInvestigation[]
  members           ProviderMember[]

  @@map("providers")
}

// Additional "provider" role users on the same small business, beyond the
// single ownerUserId above — ownerUserId stays the account that created the
// business (and the identity notifications/audit/XP-on-approval already key
// off), this is purely for teammates the owner invites afterward at
// /provider/team. userId is unique: unlike corporate's domain-match (which
// doesn't fit here — sole traders use personal email domains shared by
// millions of unrelated people), a provider-role person belongs to at most
// one small business, added explicitly by email, not implicitly by domain.
model ProviderMember {
  id         String   @id @default(uuid())
  providerId String   @map("provider_id")
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  userId     String   @unique @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([providerId])
  @@map("provider_members")
}

enum FreshnessStatus {
  fresh
  stale
  unverified
}

enum ListingStatus {
  draft
  pending_review
  published
  rejected
}

// Who/what most recently wrote this listing's data — surfaced publicly on
// /listing/[id] ("Last updated by ...") so a shopper can tell a scraper's
// guess apart from the business's own confirmation. `seed` is the default so
// every pre-existing/admin-seeded row has a defined value without a backfill.
enum ListingUpdateSource {
  admin
  scraper
  corporate
  seed
}

model Listing {
  id               String              @id @default(uuid())
  categoryId       String              @map("category_id")
  category         Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  providerId       String              @map("provider_id")
  provider         Provider            @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  attributes       Json
  price            Decimal             @db.Decimal(12, 2)
  currency         String              @default("USD")
  sourceUrl        String?             @map("source_url")
  images           String[]            @default([]) @map("images")
  // Real user reviews aren't collected anywhere in the app yet — these stay
  // null until that exists. Never backfill/estimate a value here; the UI
  // must render "No reviews yet" rather than invent a number.
  rating           Decimal?            @db.Decimal(2, 1)
  reviewCount      Int                 @default(0) @map("review_count")
  lastVerifiedAt   DateTime            @default(now()) @map("last_verified_at")
  freshnessStatus  FreshnessStatus     @default(fresh) @map("freshness_status")
  // Provider self-submission workflow (build plan 15.2): draft -> pending_review
  // -> published/rejected. Defaults to "published" so every existing/admin-created
  // listing keeps behaving exactly as before — this workflow only applies to
  // listings a provider submits through /provider.
  status           ListingStatus       @default(published)
  rejectionReason  String?             @map("rejection_reason")
  lastUpdateSource ListingUpdateSource @default(seed) @map("last_update_source")

  priceHistory      ListingPriceHistory[]
  savedBy           SavedListing[]
  pinnedBy          PinnedListing[]
  recommendations   Recommendation[]
  notifications     Notification[]
  scrapedItems      ScrapedItem[]
  corporateRequests CorporateRequest[]
  updateLogs        ListingUpdateLog[]
  discountRules     DiscountRule[]
  investigations    ListingInvestigation[]
  marketBasketItems MarketBasketItem[]
  complaints        ConsumerComplaint[]

  // (categoryId, status, price): the consumer-facing hot path — every
  // catalog read filters this combination then orders by price
  // (getCategoryWithListings et al.). status alone: the admin review queue
  // filters by status with no categoryId, which can't use the composite
  // index's later columns without its first. providerId: the provider
  // portal's "my listings" query.
  @@index([categoryId, status, price])
  @@index([status])
  @@index([providerId])
  @@map("listings")
}

model ListingPriceHistory {
  id         String   @id @default(uuid())
  listingId  String   @map("listing_id")
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  price      Decimal  @db.Decimal(12, 2)
  recordedAt DateTime @default(now()) @map("recorded_at")

  // computePriceTrend/computePriceForecast read a listing's full history
  // ordered by time — this is the exact access pattern.
  @@index([listingId, recordedAt])
  @@map("listing_price_history")
}

/// Append-only "what changed and by whom" trail for a listing — mirrors
/// ListingPriceHistory's shape but for the full edit (name/description/
/// attributes/etc, not just price), written by every write path that sets
/// Listing.lastUpdateSource (admin edit, scraper approval, corporate direct
/// edit). Shown in the corporate portal's product list and (source only,
/// never actorLabel for admin) on the public listing page.
model ListingUpdateLog {
  id            String              @id @default(uuid())
  listingId     String              @map("listing_id")
  listing       Listing             @relation(fields: [listingId], references: [id], onDelete: Cascade)
  source        ListingUpdateSource
  // Admin email / "Web scraper" / the provider's name — internal record only,
  // never rendered on the public listing page for source: admin (see
  // PROVENANCE_LABEL in listingDisplay.ts).
  actorLabel    String              @map("actor_label")
  changeSummary String              @map("change_summary")
  createdAt     DateTime            @default(now()) @map("created_at")

  @@index([listingId, createdAt(sort: Desc)])
  @@map("listing_update_logs")
}

enum CorporateRequestType {
  edit
  new_listing
}

enum CorporateRequestStatus {
  pending
  approved
  rejected
}

/// A "corporate" role account's proposed price/product change, awaiting
/// admin review — never written to Listing directly (mirrors ScrapedItem's
/// pending/approved/rejected shape above, but submitted by the business
/// itself rather than extracted from a scraped page). See
/// /corporate/products and /admin/corporate-requests.
model CorporateRequest {
  id                String                 @id @default(uuid())
  providerId        String                 @map("provider_id")
  provider          Provider               @relation(fields: [providerId], references: [id], onDelete: Cascade)
  submittedByUserId String                 @map("submitted_by_user_id")
  submittedBy       User                   @relation(fields: [submittedByUserId], references: [id], onDelete: Cascade)
  type              CorporateRequestType
  // Set for `edit` — the listing this request proposes to change.
  listingId         String?                @map("listing_id")
  listing           Listing?               @relation(fields: [listingId], references: [id], onDelete: Cascade)
  // Set for `new_listing` — needed to know the attribute schema when
  // creating the Listing on approval, since there's no existing row yet.
  categoryId        String?                @map("category_id")
  category          Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // {name, description, price, currency, attributes, images}
  proposedData      Json                   @map("proposed_data")
  // The business's justification for the change — expected here (formal,
  // audited accounts) even though the informal provider self-edit flow has
  // no equivalent field.
  reason            String
  status            CorporateRequestStatus @default(pending)
  reviewedByEmail   String?                @map("reviewed_by_email")
  reviewedAt        DateTime?              @map("reviewed_at")
  // Admin's confirmation note on approval — a lightweight "digital sign-off"
  // (this app has no e-signature capture anywhere), distinct from
  // rejectionReason which is shown back to the business, not internal.
  reviewNote        String?                @map("review_note")
  rejectionReason   String?                @map("rejection_reason")
  // Set on creation (see corporateRequestSla.ts) so the review queue can
  // surface how close a request is to breaching its review window.
  dueAt             DateTime?              @map("due_at")
  createdAt         DateTime               @default(now()) @map("created_at")

  @@index([providerId])
  @@index([status, createdAt(sort: Desc)])
  @@map("corporate_requests")
}

// ---------------------------------------------------------------------------
// 4.3 User comparison activity
// ---------------------------------------------------------------------------

model Comparison {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  listingIds String[] @map("listing_ids")
  createdAt  DateTime @default(now()) @map("created_at")

  // Every quest-progress check (category_count/comparison_count/
  // sector_diversity criteria) queries exactly userId + a createdAt range,
  // on every comparison_completed event.
  @@index([userId, createdAt(sort: Desc)])
  // getAlsoCompared's `listingIds: { has: listingId }` is an array-
  // containment query — a GIN index is the correct index type for that,
  // not a btree.
  @@index([listingIds], type: Gin)
  @@map("comparisons")
}

model SavedListing {
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String   @map("listing_id")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  savedAt   DateTime @default(now()) @map("saved_at")

  @@id([userId, listingId])
  // The PK above already covers a plain userId filter (leftmost prefix),
  // but the saved-listings page also orders by savedAt (most recent
  // first) — a separate index matching that exact order avoids an
  // in-memory sort.
  @@index([userId, savedAt(sort: Desc)])
  @@map("saved_listings")
}

model PinnedListing {
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String   @map("listing_id")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  pinnedAt  DateTime @default(now()) @map("pinned_at")

  @@id([userId, listingId])
  // Mirrors saved_listings: the PK covers a plain userId filter, and a
  // (userId, pinnedAt) index keeps the "pins first" recents ordering an
  // index scan instead of an in-memory sort.
  @@index([userId, pinnedAt(sort: Desc)])
  @@map("pinned_listings")
}

model Recommendation {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId    String   @map("listing_id")
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  explanation  String
  confidence   Decimal  @db.Decimal(4, 3)
  scoreVersion String   @default("v1") @map("score_version")
  generatedAt  DateTime @default(now()) @map("generated_at")

  @@index([listingId])
  @@index([userId, generatedAt(sort: Desc)])
  @@map("recommendations")
}

enum NotificationType {
  price_drop
  listing_approved
  listing_rejected
  // Corporate: an AlertRule's provider-scoped metric crossed its threshold.
  // Not tied to one listing, so this is the first type without a listingId.
  alert_threshold_crossed
  // Admin: a BusinessCondition assigned to this admin is past its review cycle.
  business_condition_review_due
  // Regulator: a PriceCapRule's gazetted ceiling is breached by at least one
  // published listing in its category — one summary notification per rule,
  // same "compute + upsert on read" shape as alert_threshold_crossed.
  price_cap_breached
  // Admin: a corporate/provider/regulator applicant just finished onboarding
  // (see notifyAdminNewApplication in src/lib/notifications.ts) — scoped by
  // applicantUserId below, not a listing.
  user_application_submitted
}

model Notification {
  id                  String             @id @default(uuid())
  userId              String             @map("user_id")
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Nullable: alert_threshold_crossed, business_condition_review_due, and
  // price_cap_breached notifications reference an AlertRule/
  // BusinessCondition/PriceCapRule instead (below), not a single listing.
  listingId           String?            @map("listing_id")
  listing             Listing?           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  alertRuleId         String?            @map("alert_rule_id")
  alertRule           AlertRule?         @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)
  businessConditionId String?            @map("business_condition_id")
  businessCondition   BusinessCondition? @relation(fields: [businessConditionId], references: [id], onDelete: Cascade)
  priceCapRuleId      String?            @map("price_cap_rule_id")
  priceCapRule        PriceCapRule?      @relation(fields: [priceCapRuleId], references: [id], onDelete: Cascade)
  // Scoping column for user_application_submitted — the applicant, not the
  // admin (userId above is the admin being notified). No back-relation on
  // User for this one (it would collide with the `notifications` relation
  // already there for userId), so it's a plain column + relation without a
  // named opposite field.
  applicantUserId     String?            @map("applicant_user_id")
  applicant           User?              @relation("NotificationApplicant", fields: [applicantUserId], references: [id], onDelete: Cascade)
  type                NotificationType   @default(price_drop)
  message             String
  // Only meaningful for price_drop; null for every other type.
  changePercent       Float?             @map("change_percent")
  read                Boolean            @default(false)
  createdAt           DateTime           @default(now()) @map("created_at")

  // Each unique constraint dedupes one type's re-sync (upsert) against its
  // own scoping column; the other scoping columns are null on that row, and
  // Postgres treats NULL as distinct in a unique index, so these four
  // constraints never conflict with each other.
  @@unique([userId, listingId, type])
  @@unique([userId, alertRuleId, type])
  @@unique([userId, businessConditionId, type])
  @@unique([userId, priceCapRuleId, type])
  @@unique([userId, applicantUserId, type])
  @@index([listingId])
  @@index([userId, read, createdAt(sort: Desc)])
  @@map("notifications")
}

