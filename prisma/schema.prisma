// KuwanaAI Database Architecture
// One PostgreSQL schema (public), Prisma-only access
// Principles: schema-driven catalog, JSON flexible payloads, Decimal for money, uuid() PKs, Cascade/SetNull deletes

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ENUMS
//

enum Role {
  CONSUMER
  PROVIDER
  CORPORATE
  REGULATOR
}

enum Sector {
  TELECOMS
  ENERGY
  INSURANCE
  BANKING
  HEALTHCARE
  RETAIL_GROCERY
  FUEL
  EDUCATION
  HOUSING
  TRANSPORT
}

enum SectorStatus {
  ACTIVE
  COMING_SOON
  DISABLED
}

enum AttributeDataType {
  STRING
  NUMBER
  BOOLEAN
  ENUM
  CURRENCY
  DATE
  RANGE
}

enum FreshnessStatus {
  FRESH
  STALE
  EXPIRED
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum NotificationType {
  PRICE_DROP
  NEW_LISTING
  DEAL_EXPIRING
  RECOMMENDATION
  SYSTEM
  STREAK_REMINDER
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

enum EventType {
  FOOTPRINT_CREATED
  COMPARISON_CREATED
  LISTING_SAVED
  CONVERSATION_STARTED
  RECOMMENDATION_VIEWED
  PROFILE_COMPLETED
  DAILY_LOGIN
  REFERRAL_COMPLETED
}

enum SocialPlatform {
  FACEBOOK
  TWITTER
  WHATSAPP
  TELEGRAM
  TIKTOK
  INSTAGRAM
}

//
// IDENTITY & ONBOARDING
//

model User {
  id               String   @id @default(uuid()) @db.Uuid
  email            String   @unique
  supabaseAuthId   String?  @unique @map("supabase_auth_id")
  role             Role     @default(CONSUMER)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // relations - all cascade as user-owned data
  profile          UserProfile?
  footprints       SectorFootprint[]
  consents         Consent[]
  comparisons      Comparison[]
  savedListings    SavedListing[]
  recommendations  Recommendation[]
  notifications    Notification[]
  conversations    Conversation[]
  events           UserEvent[]
  xp               UserXp?
  streak           UserStreak?
  badges           UserBadge[]
  questProgress    UserQuestProgress[]
  ownedProviders   Provider[] @relation("ProviderOwner")

  @@map("users")
}

model UserProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String?  @map("display_name")
  fullName    String?  @map("full_name")
  phone       String?
  avatarUrl   String?  @map("avatar_url")
  location    String?
  preferences Json?    @default("{}") // loose JSON, zod-validated
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("user_profiles")
}

model SectorFootprint {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector    Sector
  data      Json     @default("{}") // answers to sector onboarding
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, sector])
  @@map("sector_footprints")
}

model Consent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // e.g. data_processing, marketing, ai_personalization
  granted   Boolean  @default(false)
  grantedAt DateTime? @map("granted_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, type])
  @@map("consents")
}

//
// SECTOR CATALOG - Schema-driven, no DDL for new sectors/categories
//

model SectorConfig {
  id          String       @id @default(uuid()) @db.Uuid
  slug        String       @unique // e.g. telecoms, energy
  name        String
  sector      Sector       @unique
  status      SectorStatus @default(ACTIVE)
  description String?
  icon        String?
  order       Int          @default(0)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  categories  Category[]
  providers   Provider[]
  listings    Listing[] // denormalized via category but useful for direct query

  @@map("sector_configs")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  sectorId    String   @map("sector_id") @db.Uuid
  sector      SectorConfig @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  attributeSchemas AttributeSchemaField[]
  listings         Listing[]

  @@unique([sectorId, slug])
  @@map("categories")
}

model AttributeSchemaField {
  id         String            @id @default(uuid()) @db.Uuid
  categoryId String            @map("category_id") @db.Uuid
  category   Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  key        String // e.g. data_limit_gb, monthly_fee
  label      String
  dataType   AttributeDataType @map("data_type")
  required   Boolean           @default(false)
  options    Json? // for ENUM: ["prepaid","postpaid"]
  unit       String? // e.g. GB, USD, ZWG
  order      Int               @default(0)
  helpText   String?           @map("help_text")
  createdAt  DateTime          @default(now()) @map("created_at")

  @@unique([categoryId, key])
  @@map("attribute_schemas")
}

model Provider {
  id         String   @id @default(uuid()) @db.Uuid
  slug       String   @unique
  name       String
  logoUrl    String?  @map("logo_url")
  website    String?
  sectorId   String?  @map("sector_id") @db.Uuid
  sector     SectorConfig? @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  ownerId    String?  @map("owner_id") @db.Uuid
  owner      User?    @relation("ProviderOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  isVerified Boolean  @default(false) @map("is_verified")
  metadata   Json?    @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  listings   Listing[]

  @@map("providers")
}

model Listing {
  id               String              @id @default(uuid()) @db.Uuid
  categoryId       String              @map("category_id") @db.Uuid
  category         Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sectorId         String?             @map("sector_id") @db.Uuid
  sector           SectorConfig?       @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  providerId       String?             @map("provider_id") @db.Uuid
  provider         Provider?           @relation(fields: [providerId], references: [id], onDelete: SetNull)
  title            String
  slug             String?
  description      String?             @db.Text
  attributes       Json                @default("{}") // validated by zod against AttributeSchemaField
  status           ListingStatus       @default(DRAFT)
  freshnessStatus  FreshnessStatus     @default(FRESH) @map("freshness_status")
  effectiveFrom    DateTime?           @map("effective_from")
  effectiveTo      DateTime?           @map("effective_to")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  priceHistory     ListingPriceHistory[]
  savedBy          SavedListing[]
  recommendations  Recommendation[]
  notifications    Notification[]

  // HOT PATH INDEXES - added in v2 migration, originally noted as gap
  @@index([categoryId])
  @@index([providerId])
  @@index([status])
  @@index([sectorId])
  @@map("listings")
}

model ListingPriceHistory {
  id         String   @id @default(uuid()) @db.Uuid
  listingId  String   @map("listing_id") @db.Uuid
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  price      Decimal  @db.Decimal(12, 2)
  currency   String   @default("USD")
  recordedAt DateTime @default(now()) @map("recorded_at")
  source     String? // manual, scraped, social_mention
  metadata   Json?    @default("{}")

  @@index([listingId, recordedAt])
  @@map("listing_price_history")
}

//
// COMPARISON ACTIVITY
//

model Comparison {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector     Sector?
  title      String?
  listingIds Json     @default("[]") @map("listing_ids") // uuid[]
  scores     Json?    // { listingId: score, breakdown }
  metadata   Json?    @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("comparisons")
}

model SavedListing {
  userId    String   @map("user_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  savedAt   DateTime @default(now()) @map("saved_at")

  @@id([userId, listingId])
  @@map("saved_listings")
}

model Recommendation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String?  @map("listing_id") @db.Uuid
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  reason    String?  @db.Text
  score     Decimal? @db.Decimal(5, 2)
  metadata  Json?    @default("{}")
  viewed    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("recommendations")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String?          @map("listing_id") @db.Uuid
  listing   Listing?         @relation(fields: [listingId], references: [id], onDelete: SetNull)
  type      NotificationType
  title     String
  body      String?          @db.Text
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")

  @@unique([userId, listingId, type])
  @@map("notifications")
}

//
// AI CHAT
//

model Conversation {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  sector    Sector?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  messages  Message[]

  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ChatRole
  content        String       @db.Text
  listingIds     String[]     @default([]) @map("listing_ids") @db.Uuid // grounding
  metadata       Json?        @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("messages")
}

//
// GAMIFICATION - evaluated in-transaction, no queue
//

model GamificationRule {
  id          String    @id @default(uuid()) @db.Uuid
  eventType   EventType @unique @map("event_type")
  xpAward     Int       @map("xp_award")
  description String?
  criteria    Json?     @default("{}")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("gamification_rules")
}

model UserEvent {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType EventType @map("event_type")
  metadata  Json?     @default("{}")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, eventType])
  @@map("user_events")
}

model UserXp {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalXp   Int      @default(0) @map("total_xp")
  level     Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_xp")
}

model UserStreak {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @unique @map("user_id") @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak Int       @default(0) @map("current_streak")
  longestStreak Int       @default(0) @map("longest_streak")
  lastActiveAt  DateTime? @map("last_active_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("user_streaks")
}

model Badge {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String
  iconUrl     String?  @map("icon_url")
  criteria    Json?    // zod: { minComparisons, sectors, etc }
  xpReward    Int?     @map("xp_reward")
  createdAt   DateTime @default(now()) @map("created_at")

  earnedBy    UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId  String   @map("badge_id") @db.Uuid
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt DateTime @default(now()) @map("earned_at")

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model Quest {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String   @db.Text
  criteria    Json?    // { type, target, count }
  xpReward    Int      @map("xp_reward")
  active      Boolean  @default(true)
  startsAt    DateTime? @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  createdAt   DateTime @default(now()) @map("created_at")

  progress    UserQuestProgress[]

  @@map("quests")
}

model UserQuestProgress {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId     String    @map("quest_id") @db.Uuid
  quest       Quest     @relation(fields: [questId], references: [id], onDelete: Cascade)
  progress    Json?     @default("{}")
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([userId, questId])
  @@map("user_quest_progress")
}

//
// INTELLIGENCE FEED
//

model SocialPriceMention {
  id              String         @id @default(uuid()) @db.Uuid
  platform        SocialPlatform
  sourceUrl       String         @map("source_url") @db.Text
  content         String         @db.Text
  matchedProvider String?        @map("matched_provider")
  extractedPrices Json?          @map("extracted_prices") // [{ amount, currency, context }]
  sector          Sector?
  confidence      Decimal?       @db.Decimal(3, 2)
  createdAt       DateTime       @default(now()) @map("created_at")

  @@unique([platform, sourceUrl])
  @@index([matchedProvider])
  @@map("social_price_mentions")
}

model FxRate {
  id             String   @id @default(uuid()) @db.Uuid
  baseCurrency   String   @map("base_currency")
  targetCurrency String   @map("target_currency")
  rate           Decimal  @db.Decimal(12, 6)
  source         String?
  effectiveAt    DateTime @default(now()) @map("effective_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([baseCurrency, targetCurrency, effectiveAt])
  @@index([baseCurrency, targetCurrency])
  @@map("fx_rates")
}

//
// WAITLIST
//

model WaitlistSignup {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  sector    Sector
  name      String?
  metadata  Json?    @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([email, sector])
  @@map("waitlist_signups")
}
