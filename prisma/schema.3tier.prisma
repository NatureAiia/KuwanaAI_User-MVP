// prisma/schema.3tier.prisma
// Full 3-Tier extension on top of original schema.prisma
// Tier 1: public (OLTP) - original 26 models
// Tier 2: analytics (OLAP) - aggregates, TimescaleDB
// Tier 3: serving - pgvector extension, Redis/Meilisearch external

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "analytics"]
}

// Enable extensions at top level via migration
// CREATE EXTENSION IF NOT EXISTS vector;
// CREATE EXTENSION IF NOT EXISTS timescaledb;

// ================= TIER 1: OLTP CORE (public) =================
// [PASTE FULL public schema from prisma/schema.prisma here]
// For brevity in this file, we extend Listing with vector:

model Listing {
  id               String              @id @default(uuid()) @db.Uuid
  categoryId       String              @map("category_id") @db.Uuid
  category         Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sectorId         String?             @map("sector_id") @db.Uuid
  sector           SectorConfig?       @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  providerId       String?             @map("provider_id") @db.Uuid
  provider         Provider?           @relation(fields: [providerId], references: [id], onDelete: SetNull)
  title            String
  slug             String?
  description      String?             @db.Text
  attributes       Json                @default("{}")
  status           ListingStatus       @default(DRAFT)
  freshnessStatus  FreshnessStatus     @default(FRESH) @map("freshness_status")
  effectiveFrom    DateTime?           @map("effective_from")
  effectiveTo      DateTime?           @map("effective_to")
  // Tier 3 addition
  embedding        Unsupported("vector(1536)")? // pgvector
  searchBlob       String?             @map("search_blob") @db.Text // flattened for Meilisearch sync
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  priceHistory     ListingPriceHistory[]
  savedBy          SavedListing[]
  recommendations  Recommendation[]
  notifications    Notification[]

  @@index([categoryId])
  @@index([providerId])
  @@index([status])
  @@index([sectorId])
  @@schema("public")
  @@map("listings")
}

// ... [All other Tier 1 models from original schema remain in public schema] ...
