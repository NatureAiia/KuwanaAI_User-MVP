# Everything that must not enter the build context. Keeping this tight is not
# cosmetic: a fat context is uploaded to the daemon on every build, and any
# secret that lands here can be recovered from the published image layers.

# Secrets — never, under any circumstances, in an image layer.
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies and build output are produced inside the image, not copied in.
node_modules
.next
out
build
coverage
*.tsbuildinfo

# VCS and CI
.git
.gitignore
.github

# Agent/editor scratch
.claude
.agents
.windsurf
.vscode
.idea
skills-lock.json

# Deploy assets — changing a Helm value must not invalidate the image cache.
deploy
docker-compose*.yml
Dockerfile*
.dockerignore

# Docs and design assets not needed at runtime
*.md
!README.md
color pallete.png

# Local logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
